# ==============================================================================
# LA PARTE ARRENDATARIA — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env para desarrollo local o configura estas variables
# en la consola de Google Cloud Run para el despliegue en producción.

# ------------------------------------------------------------------------------
# 1. Dominio y URL Base de la Edición Digital (Generación de QR y Enlaces)
# ------------------------------------------------------------------------------
# URL base para los códigos QR impresos en el fanzine y enlaces canónicos.
# Si un artículo no tiene fuente externa, el QR apuntará a ${SITE_URL}/articulo/${slug}.
SITE_URL=https://www.arrendataria.org
DOMAIN=www.arrendataria.org

# ------------------------------------------------------------------------------
# 2. Proyecto de Google Cloud Platform (Firestore, Cloud Run & Storage)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=la-parte-arrendataria
GOOGLE_CLOUD_PROJECT=la-parte-arrendataria

# Clave de Cuenta de Servicio (usada en local; en Cloud Run se usan credenciales automáticas)
GOOGLE_APPLICATION_CREDENTIALS=/Users/guille/Projects/La Parte Arrendataria/service-account.json
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# Google Cloud Storage Bucket para imágenes halftone y fanzines compilados
GCS_BUCKET_NAME=la-parte-arrendataria-media

# ------------------------------------------------------------------------------
# 3. Configuración del Servidor Web
# ------------------------------------------------------------------------------
PORT=4321
HOST=0.0.0.0
NODE_ENV=development
