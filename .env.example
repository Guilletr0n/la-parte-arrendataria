# Google Cloud Platform & Firebase Configuration
# (En entorno local funciona automáticamente con almacenamiento local sin necesidad de configurar estas variables)

# 1. Proyecto de Google Cloud
GCP_PROJECT_ID=la-parte-arrendataria
GOOGLE_CLOUD_PROJECT=la-parte-arrendataria

# 2. Clave de Cuenta de Servicio Firebase (opcional si se usa Application Default Credentials en Cloud Run)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# 3. Google Cloud Storage Bucket para imágenes y PDFs
GCS_BUCKET_NAME=la-parte-arrendataria-media

# 4. Configuración del Servidor
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
