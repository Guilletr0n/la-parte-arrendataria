---
interface Props {
  isPrintView?: boolean;
  editionDate?: string;
  issueNumber?: string;
}

const {
  isPrintView = false,
  editionDate = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long' }),
  issueNumber = 'Nº 01',
} = Astro.props;
---

<header class={`w-full ${isPrintView ? 'print-header' : 'mb-8'}`}>
  <!-- Meta bar: Fecha, Lugar, Precio guerrilla -->
  <div class="flex justify-between items-center text-xs font-mono border-b-2 border-black pb-1 mb-2 uppercase tracking-wider font-semibold">
    <span>España</span>
    <span>{editionDate}</span>
    <span>Ejemplar Libre</span>
  </div>

  <!-- Identidad Editorial -->
  <div class="text-center py-2">
    <div class="text-base sm:text-lg md:text-xl font-mono tracking-[0.25em] uppercase font-bold text-gray-800">
      LA PARTE
    </div>
    <div class="inline-block w-full max-w-full my-1">
      <div class="border-[3px] sm:border-[4px] border-black bg-white px-3 py-1 sm:px-6 sm:py-2 shadow-[4px_4px_0px_#000] inline-block w-full">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight font-serif uppercase text-black m-0 leading-none">
          <a href="/" class="hover:opacity-85 transition-opacity block text-black no-underline" title="Volver a la portada">
            ARRENDATARIA
          </a>
        </h1>
      </div>
    </div>
    <p class="text-xs sm:text-sm font-mono italic text-gray-700 mt-1 uppercase tracking-widest">
      Crea tu propio fanzine y repártelo en tu barrio
    </p>
  </div>

  <!-- Filete tipográfico doble -->
  <div class="border-t-[3px] border-b border-black h-1 my-2"></div>
</header>
