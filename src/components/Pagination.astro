---
interface Props {
  currentPage: number;
  totalPages: number;
  totalItems: number;
  itemLabel: string;
  baseUrl: string;
}

const { currentPage, totalPages, totalItems, itemLabel, baseUrl } = Astro.props;

function pageUrl(p: number) {
  return `${baseUrl}?page=${p}`;
}
---

{totalPages > 1 && (
  <div class="flex flex-wrap justify-between items-center gap-3 pt-4 border-t-2 border-black font-mono text-xs mt-4">
    <div class="text-gray-600">
      Mostrando página <strong>{currentPage}</strong> de <strong>{totalPages}</strong> ({totalItems} {itemLabel})
    </div>

    <div class="flex items-center gap-1">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} class="brutal-btn bg-white hover:bg-yellow-200 py-1 px-2.5 font-bold">
          ← Anterior
        </a>
      ) : (
        <span class="py-1 px-2.5 border-2 border-gray-300 text-gray-400 font-bold cursor-not-allowed">
          ← Anterior
        </span>
      )}

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
        <a
          href={pageUrl(pageNum)}
          class={`py-1 px-2.5 font-bold border-2 border-black transition-colors ${
            pageNum === currentPage
              ? 'bg-black text-white'
              : 'bg-white hover:bg-yellow-200 text-black'
          }`}
        >
          {pageNum}
        </a>
      ))}

      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} class="brutal-btn bg-white hover:bg-yellow-200 py-1 px-2.5 font-bold">
          Siguiente →
        </a>
      ) : (
        <span class="py-1 px-2.5 border-2 border-gray-300 text-gray-400 font-bold cursor-not-allowed">
          Siguiente →
        </span>
      )}
    </div>
  </div>
)}
