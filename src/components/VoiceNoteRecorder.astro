---
interface Props {
  initialAudioUrl?: string;
}

const { initialAudioUrl = '' } = Astro.props;
---

<div class="border-2 border-black p-4 bg-gray-50 font-mono text-xs">
  <div class="flex items-center justify-between mb-2">
    <label class="font-bold uppercase text-black flex items-center gap-1.5" for="audioUrl">
      <span>3. Nota de voz (Máx 2 min.)</span>
    </label>
    <span class="bg-black text-white text-[10px] px-1.5 py-0.5 uppercase">Regla Editorial</span>
  </div>

  <input type="hidden" id="audioUrl" name="audioUrl" value={initialAudioUrl} />

  <!-- ESTADO 1: INICIAL (Sin audio) -->
  <div id="recorder-idle" class={initialAudioUrl ? 'hidden' : 'space-y-2'}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 bg-white border-2 border-black">
      <div class="space-y-1">
        <span class="font-bold text-black block">🎙️ Grabación directa con micrófono</span>
        <p class="text-[11px] text-gray-600 m-0">
          Graba una crónica o testimonio de viva voz (máx. 2 minutos). Al llegar a los 120s se cortará automáticamente.
        </p>
      </div>
      <button
        type="button"
        id="btn-start-record"
        class="brutal-btn bg-red-700 text-white hover:bg-black font-bold text-xs py-2 px-3 whitespace-nowrap cursor-pointer flex items-center justify-center gap-2 flex-shrink-0 shadow-[2px_2px_0px_#000]"
      >
        <span>●</span>
        <span>Iniciar Grabación</span>
      </button>
    </div>
  </div>

  <!-- ESTADO 2: GRABANDO EN DIRECTO -->
  <div id="recorder-recording" class="hidden p-3 bg-yellow-100 border-2 border-black space-y-3 shadow-[3px_3px_0px_#000]">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 font-bold text-red-700 uppercase">
        <span class="w-3 h-3 rounded-full bg-red-600 animate-ping inline-block"></span>
        <span class="tracking-wider">Grabando nota de voz...</span>
      </div>
      <span id="record-timer" class="font-black text-xs sm:text-sm bg-black text-white px-2 py-0.5">
        00:00 / 02:00
      </span>
    </div>

    <!-- Barra de progreso hasta 120 segundos -->
    <div class="w-full bg-gray-200 border-2 border-black h-3 overflow-hidden">
      <div id="record-progress" class="bg-red-600 h-full w-0 transition-all duration-300"></div>
    </div>

    <div class="flex justify-end gap-2 pt-1">
      <button
        type="button"
        id="btn-cancel-record"
        class="brutal-btn bg-white hover:bg-gray-100 text-xs py-1.5 px-3 cursor-pointer"
      >
        ✕ Cancelar
      </button>
      <button
        type="button"
        id="btn-stop-record"
        class="brutal-btn brutal-btn-primary text-xs py-1.5 px-3 font-bold cursor-pointer"
      >
        ⏹ Detener y Escuchar
      </button>
    </div>
  </div>

  <!-- ESTADO 3: AUDIO LISTO / PREESCUCHA -->
  <div id="recorder-preview" class={initialAudioUrl ? 'space-y-3' : 'hidden space-y-3'}>
    <div class="p-3 bg-white border-2 border-black shadow-[3px_3px_0px_#000] space-y-2">
      <div class="flex items-center justify-between text-[11px]">
        <span class="font-bold uppercase text-green-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-green-600 inline-block"></span>
          <span>✓ Nota de voz preparada</span>
        </span>
        <span id="preview-status-text" class="text-gray-500 italic">
          {initialAudioUrl ? 'Audio actual del artículo' : 'Audio recién grabado'}
        </span>
      </div>

      <audio
        id="audio-preview-player"
        controls
        src={initialAudioUrl || ''}
        class="w-full h-10 accent-black border border-black bg-gray-50"
      >
        Tu navegador no soporta el reproductor de audio.
      </audio>

      <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-gray-300">
        <button
          type="button"
          id="btn-remove-audio"
          class="text-red-700 hover:text-black font-bold text-[11px] underline cursor-pointer"
        >
          🗑️ Eliminar nota de voz
        </button>

        <button
          type="button"
          id="btn-rerecord"
          class="brutal-btn bg-yellow-200 hover:bg-yellow-300 text-black text-[11px] font-bold py-1 px-3 cursor-pointer"
        >
          🔄 Grabar de nuevo
        </button>
      </div>
    </div>
  </div>

  <!-- Mensaje de aviso de error de micrófono si procede -->
  <div id="recorder-error" class="hidden mt-2 p-2 bg-red-100 border-2 border-red-700 text-red-900 text-xs font-bold"></div>
</div>

<script is:inline>
  (() => {
    let mediaRecorder = null;
    let audioChunks = [];
    let recordTimerInterval = null;
    let secondsElapsed = 0;
    const MAX_SECONDS = 120; // 2 minutos exactos
    let recordedBlob = null;
    let activeStream = null;

    const idleBox = document.getElementById('recorder-idle');
    const recordingBox = document.getElementById('recorder-recording');
    const previewBox = document.getElementById('recorder-preview');
    const timerDisplay = document.getElementById('record-timer');
    const progressBar = document.getElementById('record-progress');
    const player = document.getElementById('audio-preview-player');
    const audioUrlInput = document.getElementById('audioUrl');
    const errorBox = document.getElementById('recorder-error');
    const previewStatus = document.getElementById('preview-status-text');

    function showError(msg) {
      if (errorBox) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }
    }

    function clearError() {
      if (errorBox) {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
      }
    }

    function formatTime(totalSec) {
      const m = Math.floor(totalSec / 60).toString().padStart(2, '0');
      const s = (totalSec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function updateTimerUI() {
      if (timerDisplay) {
        timerDisplay.textContent = `${formatTime(secondsElapsed)} / 02:00`;
      }
      if (progressBar) {
        const pct = Math.min(100, (secondsElapsed / MAX_SECONDS) * 100);
        progressBar.style.width = `${pct}%`;
      }
    }

    async function startRecording() {
      clearError();
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        showError('Tu navegador o dispositivo no tiene soporte para grabación de micrófono en esta conexión (se requiere HTTPS o localhost).');
        return;
      }

      try {
        activeStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch (err) {
        console.error('Error accediendo al micrófono:', err);
        showError('No se pudo acceder al micrófono. Por favor, concede los permisos en tu navegador.');
        return;
      }

      // Detect supported mime type
      let mimeType = 'audio/webm;codecs=opus';
      if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'audio/webm';
      if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'audio/mp4';
      if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = '';

      try {
        mediaRecorder = mimeType ? new MediaRecorder(activeStream, { mimeType }) : new MediaRecorder(activeStream);
      } catch (e) {
        mediaRecorder = new MediaRecorder(activeStream);
      }

      audioChunks = [];
      secondsElapsed = 0;
      updateTimerUI();

      mediaRecorder.ondataavailable = (event) => {
        if (event.data && event.data.size > 0) {
          audioChunks.push(event.data);
        }
      };

      mediaRecorder.onstop = () => {
        clearInterval(recordTimerInterval);
        if (activeStream) {
          activeStream.getTracks().forEach((track) => track.stop());
          activeStream = null;
        }

        if (audioChunks.length > 0) {
          const finalMime = mediaRecorder.mimeType || 'audio/webm';
          recordedBlob = new Blob(audioChunks, { type: finalMime });
          const blobUrl = URL.createObjectURL(recordedBlob);
          if (player) {
            player.src = blobUrl;
            player.load();
          }
          if (previewStatus) {
            previewStatus.textContent = `Clip grabado (${formatTime(secondsElapsed)})`;
          }
          // Switch to preview UI
          if (recordingBox) recordingBox.classList.add('hidden');
          if (previewBox) previewBox.classList.remove('hidden');
          if (idleBox) idleBox.classList.add('hidden');
        }
      };

      mediaRecorder.start(250); // Emit chunks every 250ms

      // Switch to recording UI
      if (idleBox) idleBox.classList.add('hidden');
      if (previewBox) previewBox.classList.add('hidden');
      if (recordingBox) recordingBox.classList.remove('hidden');

      recordTimerInterval = setInterval(() => {
        secondsElapsed++;
        updateTimerUI();
        if (secondsElapsed >= MAX_SECONDS) {
          stopRecording();
        }
      }, 1000);
    }

    function stopRecording() {
      clearInterval(recordTimerInterval);
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
    }

    function cancelRecording() {
      clearInterval(recordTimerInterval);
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      if (activeStream) {
        activeStream.getTracks().forEach((track) => track.stop());
        activeStream = null;
      }
      audioChunks = [];
      recordedBlob = null;
      secondsElapsed = 0;
      updateTimerUI();

      // Return to preview if previous audio existed, else idle
      if (recordingBox) recordingBox.classList.add('hidden');
      if (audioUrlInput && audioUrlInput.value) {
        if (previewBox) previewBox.classList.remove('hidden');
      } else {
        if (idleBox) idleBox.classList.remove('hidden');
      }
    }

    function removeAudio() {
      if (!confirm('¿Eliminar la nota de voz de este artículo?')) return;
      recordedBlob = null;
      if (audioUrlInput) audioUrlInput.value = '';
      if (player) player.src = '';
      if (previewBox) previewBox.classList.add('hidden');
      if (idleBox) idleBox.classList.remove('hidden');
    }

    // Attach listeners
    document.getElementById('btn-start-record')?.addEventListener('click', startRecording);
    document.getElementById('btn-stop-record')?.addEventListener('click', stopRecording);
    document.getElementById('btn-cancel-record')?.addEventListener('click', cancelRecording);
    document.getElementById('btn-rerecord')?.addEventListener('click', startRecording);
    document.getElementById('btn-remove-audio')?.addEventListener('click', removeAudio);

    // Global helper called by form submission
    window.getOrUploadAudioUrl = async function () {
      // If a new audio was recorded and not yet uploaded
      if (recordedBlob) {
        const formData = new FormData();
        const ext = recordedBlob.type.includes('mp4') ? 'voice.mp4' : 'voice.webm';
        formData.append('audio', recordedBlob, ext);

        const res = await fetch('/api/upload/audio', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();
        if (res.ok && data.audioUrl) {
          if (audioUrlInput) audioUrlInput.value = data.audioUrl;
          recordedBlob = null; // Mark as uploaded
          return data.audioUrl;
        } else {
          throw new Error(data.error || 'Error al subir la nota de voz');
        }
      }

      // Return existing audioUrl (or empty)
      return audioUrlInput ? audioUrlInput.value : '';
    };
  })();
</script>
