---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import Pagination from '../../components/Pagination.astro';
import { getCurrentUser, canPublish, canDelete, canManageUsers } from '../../lib/auth';
import { getArticles } from '../../lib/db';
import { getUsers } from '../../lib/users';

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/login');
}

const isUserAdmin = canManageUsers(user);
const isUserEditor = user.role === 'editor';
const isUserReader = user.role === 'reader';

if (isUserReader) {
  return Astro.redirect('/admin');
}

const allUsers = isUserAdmin ? await getUsers() : [];

// Fetch articles: editors ONLY see their own articles; admins see all
const allArticles = await getArticles();
const visibleArticles = isUserEditor
  ? allArticles.filter(a => a.authorUid === user.uid)
  : allArticles;

const publishedArticles = visibleArticles.filter(a => a.status === 'published');
const draftArticles = visibleArticles.filter(a => a.status === 'draft');
const selectedForPrintArticles = visibleArticles.filter(a => a.selectedForPrint);

// Pagination logic: max 20 articles per page
const PAGE_SIZE = 20;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10));
const totalArticles = visibleArticles.length;
const totalPages = Math.ceil(totalArticles / PAGE_SIZE) || 1;
const paginatedArticles = visibleArticles.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<Layout title="Gestión de Artículos | La Parte Arrendataria" maxWidth="max-w-[950px]">
  <!-- Top Bar: User info & Logout -->
  <div class="border-2 border-black bg-white p-3 mb-4 flex flex-wrap justify-between items-center font-mono text-xs shadow-[3px_3px_0px_#000]">
    <div class="flex items-center gap-2">
      <span class={`px-2 py-0.5 font-bold uppercase text-white ${
        isUserAdmin ? 'bg-red-700' : isUserEditor ? 'bg-blue-800' : 'bg-gray-700'
      }`}>
        ROL: {user.role.toUpperCase()}
      </span>
      <span class="font-bold text-black">{user.displayName}</span>
      <span class="text-gray-500">({user.email})</span>
    </div>
    <div class="flex items-center gap-3">
      <button
        type="button"
        onclick="document.getElementById('change-password-modal').showModal()"
        class="hover:underline font-bold text-black border border-black px-2 py-0.5 bg-yellow-200 hover:bg-yellow-300 transition-colors cursor-pointer"
      >
        🔑 Cambiar Contraseña
      </button>
      <a href="/" target="_blank" class="hover:underline font-bold text-black">Ver Web Pública ↗</a>
      <a href="/api/auth/logout" class="hover:underline text-red-700 font-bold">Cerrar Sesión [x]</a>
    </div>
  </div>

  <!-- Admin Navigation Tabs -->
  <AdminNav
    activeTab="articles"
    articleCount={visibleArticles.length}
    userCount={allUsers.length}
    isUserAdmin={isUserAdmin}
  />

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 font-mono text-xs">
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">
        {isUserEditor ? 'Tus Artículos' : 'Total Artículos'}
      </span>
      <span class="text-2xl font-black">{visibleArticles.length}</span>
    </div>
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Publicados</span>
      <span class="text-2xl font-black text-green-700">{publishedArticles.length}</span>
    </div>
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Borradores</span>
      <span class="text-2xl font-black text-yellow-700">{draftArticles.length}</span>
    </div>
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Para Fanzine</span>
      <span class="text-2xl font-black text-red-700">{selectedForPrintArticles.length}</span>
    </div>
  </div>

  <!-- Catálogo de Artículos Paginado -->
  <div class="border-[3px] border-black bg-white shadow-[5px_5px_0px_#000] p-4 mb-8">
    <div class="flex flex-wrap justify-between items-center border-b-2 border-black pb-2 mb-4 font-mono gap-2">
      <div>
        <span class="text-[10px] font-bold uppercase text-red-700 block tracking-wider">
          CATÁLOGO EDITORIAL
        </span>
        <h1 class="text-lg font-black uppercase tracking-tight m-0">
          {isUserAdmin ? 'Todos los Artículos de la Asamblea' : 'Tus Artículos Redactados'}
        </h1>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-black text-white px-2 py-0.5 text-xs font-bold">
          {totalArticles} {totalArticles === 1 ? 'artículo' : 'artículos'}
        </span>
        <a href="/admin/grabar-audio" class="brutal-btn bg-red-600 text-white hover:bg-black text-xs font-bold py-1 px-2.5 rounded-lg flex items-center gap-1 shadow-[2px_2px_0px_#000]">
          🎙️ Grabar Audio
        </a>
        <a href="/admin/new-article" class="brutal-btn brutal-btn-primary text-xs font-bold py-1 px-3">
          + Redactar Nuevo
        </a>
      </div>
    </div>

    {visibleArticles.length === 0 ? (
      <div class="border-2 border-dashed border-gray-400 p-8 text-center font-mono text-xs">
        <p class="font-bold text-gray-700 uppercase mb-2">No has redactado artículos todavía</p>
        <p class="text-gray-500 mb-4">Pulsa en el botón superior para enviar tu primer texto a la redacción.</p>
        <a href="/admin/new-article" class="brutal-btn brutal-btn-primary text-xs">+ Redactar Nuevo Artículo</a>
      </div>
    ) : (
      <>
        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="border-b-2 border-black bg-gray-100 uppercase">
                <th class="p-2">Estado</th>
                <th class="p-2">Título / Autor</th>
                <th class="p-2">Votos ✊🏼</th>
                <th class="p-2">Multimedia</th>
                <th class="p-2">Fanzine</th>
                <th class="p-2 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {paginatedArticles.map((art) => (
                <tr class="border-b border-gray-300 hover:bg-yellow-50">
                  <!-- Estado -->
                  <td class="p-2 whitespace-nowrap">
                    {art.status === 'published' ? (
                      <span class="bg-green-100 text-green-900 border border-green-800 px-1.5 py-0.5 font-bold">
                        PUBLICADO
                      </span>
                    ) : (
                      <span class="bg-yellow-100 text-yellow-900 border border-yellow-800 px-1.5 py-0.5 font-bold">
                        BORRADOR
                      </span>
                    )}
                  </td>

                  <!-- Título & Autor -->
                  <td class="p-2">
                    <a
                      href={`/articulo/${art.slug}`}
                      target="_blank"
                      class="font-bold text-black hover:text-red-700 hover:underline inline-flex items-center gap-1"
                      title="Abrir artículo completo en la web"
                    >
                      <span>{art.title}</span>
                      <span class="text-[10px] text-gray-500">↗</span>
                    </a>
                    <span class="text-[10px] text-gray-500 block">
                      Por {art.author} ({art.authorRole}) • {new Date(art.createdAt).toLocaleDateString('es-ES')}
                    </span>
                  </td>

                  <!-- Votos Populares -->
                  <td class="p-2 whitespace-nowrap">
                    <span class="bg-yellow-300 border border-black px-1.5 py-0.5 font-bold text-[11px]">
                      ✊🏼 {art.votes || 0}
                    </span>
                  </td>

                  <!-- Multimedia -->
                  <td class="p-2 text-[10px] whitespace-nowrap">
                    <div>📷 {art.photoUrl ? '1 Foto asignada' : 'Sin foto'}</div>
                    <div>🎙️ {(art.audioUrl || art.speakPipeAudioUrl) ? 'Nota de voz' : 'Sin audio'}</div>
                  </td>

                  <!-- Fanzine Print indicator -->
                  <td class="p-2 whitespace-nowrap">
                    {art.selectedForPrint ? (
                      <span class="bg-black text-white px-1.5 py-0.5 font-bold text-[10px]">
                        ★ #{art.printOrder || 1} ({art.fanzineCategory?.toUpperCase() || 'INTERIOR'})
                      </span>
                    ) : (
                      <span class="text-gray-400">—</span>
                    )}
                  </td>

                  <!-- Actions -->
                  <td class="p-2 text-right space-x-1 whitespace-nowrap">
                    {isUserAdmin && (
                      <button
                        type="button"
                        onclick={`togglePublish('${art.id}', '${art.status === 'published' ? 'draft' : 'published'}')`}
                        class={`brutal-btn text-[10px] py-0.5 px-2 font-bold ${
                          art.status === 'published'
                            ? 'bg-yellow-200 hover:bg-yellow-300'
                            : 'bg-green-600 text-white hover:bg-green-700'
                        }`}
                      >
                        {art.status === 'published' ? 'A Borrador' : 'Publicar'}
                      </button>
                    )}

                    <a
                      href={`/admin/edit/${art.id}`}
                      class="brutal-btn bg-white hover:bg-gray-100 text-[10px] py-0.5 px-2 inline-block"
                    >
                      Editar
                    </a>

                    {isUserAdmin && (
                      <button
                        type="button"
                        onclick={`deleteArticleConfirm('${art.id}', '${art.title.replace(/'/g, "\\'")}')`}
                        class="brutal-btn bg-red-600 text-white hover:bg-red-700 text-[10px] py-0.5 px-2 font-bold"
                      >
                        Borrar
                      </button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Paginación de Artículos -->
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          totalItems={totalArticles}
          itemLabel="artículos"
          baseUrl="/admin/articles"
        />
      </>
    )}
  </div>

  <!-- MODAL: CAMBIAR CONTRASEÑA -->
  <dialog
    id="change-password-modal"
    class="fixed inset-0 m-auto p-0 border-4 border-black bg-white shadow-[8px_8px_0px_#000] max-w-md w-[92%] backdrop:bg-black/75 z-50 overflow-hidden font-mono"
  >
    <div class="p-6 text-black">
      <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 block">
            SEGURIDAD DE LA CUENTA
          </span>
          <h3 class="font-serif text-xl font-black uppercase text-black m-0">
            Cambiar Contraseña
          </h3>
        </div>
        <button
          type="button"
          onclick="document.getElementById('change-password-modal').close()"
          class="font-black text-lg hover:bg-black hover:text-white px-2 py-0.5 border border-black transition-colors"
        >
          ✕
        </button>
      </div>

      <div id="change-pass-alert" class="hidden mb-4 p-2 text-xs font-bold border-2"></div>

      <form id="change-password-form" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold uppercase mb-1" for="current-password">
            Contraseña Actual:
          </label>
          <input
            type="password"
            id="current-password"
            required
            placeholder="Introduce tu contraseña actual"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="new-password">
            Nueva Contraseña (mínimo 6 caracteres):
          </label>
          <input
            type="password"
            id="new-password"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="confirm-new-password">
            Repite la Nueva Contraseña:
          </label>
          <input
            type="password"
            id="confirm-new-password"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t-2 border-black">
          <button
            type="button"
            onclick="document.getElementById('change-password-modal').close()"
            class="brutal-btn bg-white hover:bg-gray-100 text-xs"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="change-pass-submit-btn"
            class="brutal-btn brutal-btn-primary text-xs font-bold"
          >
            Actualizar Contraseña
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <script is:inline>
    async function togglePublish(id, newStatus) {
      if (!confirm(`¿Deseas cambiar el estado a ${newStatus.toUpperCase()}?`)) return;
      try {
        const res = await fetch(`/api/articles/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'No se pudo actualizar'));
        }
      } catch (e) {
        alert('Error de conexión');
      }
    }

    async function deleteArticleConfirm(id, title) {
      if (!confirm(`¿ELIMINAR DEFINITIVAMENTE el artículo "${title}"?`)) return;
      try {
        const res = await fetch(`/api/articles/${id}`, {
          method: 'DELETE',
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'No se pudo eliminar'));
        }
      } catch (e) {
        alert('Error de conexión');
      }
    }

    // Change Password Form
    document.getElementById('change-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const currentPassword = document.getElementById('current-password').value;
      const newPassword = document.getElementById('new-password').value;
      const confirmPassword = document.getElementById('confirm-new-password').value;
      const submitBtn = document.getElementById('change-pass-submit-btn');
      const alertBox = document.getElementById('change-pass-alert');

      if (newPassword !== confirmPassword) {
        alertBox.textContent = 'Las contraseñas no coinciden.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Actualizando...';

      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword, confirmPassword }),
        });

        const data = await res.json();
        if (res.ok) {
          alertBox.textContent = '¡Contraseña actualizada con éxito!';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-green-100 border-green-700 text-green-900';
          alertBox.classList.remove('hidden');
          setTimeout(() => {
            document.getElementById('change-password-modal').close();
            document.getElementById('change-password-form').reset();
            alertBox.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Actualizar Contraseña';
          }, 1500);
        } else {
          alertBox.textContent = data.error || 'Error al cambiar la contraseña';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
          alertBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Actualizar Contraseña';
        }
      } catch (err) {
        alertBox.textContent = 'Error de conexión con el servidor.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Actualizar Contraseña';
      }
    });
  </script>
</Layout>
