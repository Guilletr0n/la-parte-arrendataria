---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser, canPublish, canDelete, canExportPdf } from '../../lib/auth';
import { getArticles } from '../../lib/db';

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/login');
}

const allArticles = await getArticles();
const publishedArticles = allArticles.filter(a => a.status === 'published');
const draftArticles = allArticles.filter(a => a.status === 'draft');
const selectedForPrintArticles = allArticles.filter(a => a.selectedForPrint);

const isUserAdmin = canPublish(user);
const isUserEditor = user.role === 'editor';
---

<Layout title="Panel CMS | La Parte Arrendataria" maxWidth="max-w-[900px]">
  <!-- Top Bar: User info & Logout -->
  <div class="border-2 border-black bg-white p-3 mb-6 flex flex-wrap justify-between items-center font-mono text-xs shadow-[3px_3px_0px_#000]">
    <div class="flex items-center gap-2">
      <span class={`px-2 py-0.5 font-bold uppercase text-white ${isUserAdmin ? 'bg-red-700' : 'bg-blue-800'}`}>
        ROL: {user.role.toUpperCase()}
      </span>
      <span class="font-bold text-black">{user.displayName}</span>
      <span class="text-gray-500">({user.email})</span>
    </div>
    <div class="flex items-center gap-3">
      <a href="/" target="_blank" class="hover:underline font-bold text-black">Ver Web Pública ↗</a>
      <a href="/api/auth/logout" class="hover:underline text-red-700 font-bold">Cerrar Sesión [x]</a>
    </div>
  </div>

  <!-- Role Notice / Instructions -->
  {isUserEditor && (
    <div class="p-3 mb-6 bg-blue-50 border-2 border-blue-900 font-mono text-xs text-blue-900">
      <strong>MODO EDITOR:</strong> Tienes permisos para crear y editar tus propios borradores con 1 fotografía, audio SpeakPipe de hasta 2 minutos y texto en Markdown. La aprobación, publicación oficial y generación de PDF corresponden al Administrador.
    </div>
  )}

  <!-- Quick Action & Stats Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 font-mono text-xs">
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Total Artículos</span>
      <span class="text-2xl font-black">{allArticles.length}</span>
    </div>
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Publicados</span>
      <span class="text-2xl font-black text-green-700">{publishedArticles.length}</span>
    </div>
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Borradores</span>
      <span class="text-2xl font-black text-yellow-700">{draftArticles.length}</span>
    </div>
    <div class="border-2 border-black p-3 bg-white shadow-[3px_3px_0px_#000]">
      <span class="text-gray-500 block uppercase">Para Fanzine</span>
      <span class="text-2xl font-black text-red-700">{selectedForPrintArticles.length}</span>
    </div>
  </div>

  <!-- Actions Toolbar -->
  <div class="flex flex-wrap gap-3 mb-6">
    <a href="/admin/new-article" class="brutal-btn brutal-btn-primary text-xs">
      + Redactar Nuevo Artículo
    </a>
    {isUserAdmin && (
      <>
        <a href="/admin/export-fanzine" class="brutal-btn text-xs bg-yellow-300">
          ⚡ Selector de Artículos para Fanzine PDF
        </a>
        <a href="/print/issue-preview" target="_blank" class="brutal-btn text-xs">
          👁️ Vista Previa 3 Columnas
        </a>
        <a href="/api/fanzine/export" class="brutal-btn text-xs bg-red-600 text-white hover:bg-red-700">
          📥 Descarga Directa PDF (Puppeteer)
        </a>
      </>
    )}
  </div>

  <!-- Articles Table / Catalog -->
  <div class="border-[3px] border-black bg-white shadow-[5px_5px_0px_#000] p-4">
    <div class="flex justify-between items-center border-b-2 border-black pb-2 mb-4 font-mono">
      <h2 class="text-lg font-black uppercase tracking-tight">
        {isUserAdmin ? 'Catálogo Completo de Artículos' : 'Tus Artículos y Borradores'}
      </h2>
      <span class="text-xs text-gray-600">
        {allArticles.length} registros
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left font-mono text-xs border-collapse">
        <thead>
          <tr class="border-b-2 border-black bg-gray-100 uppercase">
            <th class="p-2">Estado</th>
            <th class="p-2">Título / Autor</th>
            <th class="p-2">Foto / Audio</th>
            <th class="p-2">Fanzine</th>
            <th class="p-2 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {allArticles.map((art) => (
            <tr class="border-b border-gray-300 hover:bg-yellow-50">
              <!-- Estado -->
              <td class="p-2 whitespace-nowrap">
                {art.status === 'published' ? (
                  <span class="bg-green-100 text-green-900 border border-green-800 px-1.5 py-0.5 font-bold">
                    PUBLICADO
                  </span>
                ) : (
                  <span class="bg-yellow-100 text-yellow-900 border border-yellow-800 px-1.5 py-0.5 font-bold">
                    BORRADOR
                  </span>
                )}
              </td>

              <!-- Título & Autor -->
              <td class="p-2">
                <a
                  href={`/articulo/${art.slug}`}
                  target="_blank"
                  class="font-bold text-black hover:text-red-700 hover:underline inline-flex items-center gap-1"
                  title="Abrir artículo completo en la web"
                >
                  <span>{art.title}</span>
                  <span class="text-[10px] text-gray-500">↗</span>
                </a>
                <span class="text-[10px] text-gray-500 block">
                  Por {art.author} ({art.authorRole}) • {new Date(art.createdAt).toLocaleDateString('es-ES')}
                </span>
              </td>

              <!-- Multimedia -->
              <td class="p-2 text-[10px] whitespace-nowrap">
                <div>📷 {art.photoUrl ? '1 Foto asignada' : 'Sin foto'}</div>
                <div>🎙️ {art.speakPipeAudioUrl ? 'Audio 2 min' : 'Sin audio'}</div>
              </td>

              <!-- Fanzine Print indicator -->
              <td class="p-2 whitespace-nowrap">
                {art.selectedForPrint ? (
                  <span class="bg-black text-white px-1.5 py-0.5 font-bold text-[10px]">
                    ★ ORDEN #{art.printOrder || 1}
                  </span>
                ) : (
                  <span class="text-gray-400">—</span>
                )}
              </td>

              <!-- Actions -->
              <td class="p-2 text-right space-x-1 whitespace-nowrap">
                <!-- Ver en Web -->
                <a
                  href={`/articulo/${art.slug}`}
                  target="_blank"
                  class="inline-block border border-black px-2 py-1 bg-yellow-100 hover:bg-yellow-300 font-bold text-black"
                  title="Ver artículo completo en web"
                >
                  👁️ Ver
                </a>

                <!-- Edit -->
                <a
                  href={`/admin/edit/${art.id}`}
                  class="inline-block border border-black px-2 py-1 bg-white hover:bg-black hover:text-white font-bold"
                >
                  Editar
                </a>

                <!-- Publish / Unpublish (Admin only) -->
                {isUserAdmin && (
                  <button
                    onclick={`togglePublish('${art.id}', '${art.status === 'published' ? 'draft' : 'published'}')`}
                    class={`border border-black px-2 py-1 font-bold ${
                      art.status === 'published'
                        ? 'bg-yellow-100 hover:bg-yellow-200 text-yellow-900'
                        : 'bg-green-100 hover:bg-green-200 text-green-900'
                    }`}
                  >
                    {art.status === 'published' ? 'Pausar' : 'Publicar'}
                  </button>
                )}

                <!-- Delete (Admin only) -->
                {isUserAdmin && (
                  <button
                    onclick={`deleteArticleConfirm('${art.id}', '${art.title}')`}
                    class="border border-black px-2 py-1 bg-red-100 hover:bg-red-600 hover:text-white font-bold text-red-900"
                  >
                    Borrar
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    async function togglePublish(id, newStatus) {
      if (!confirm(`¿Deseas cambiar el estado a ${newStatus.toUpperCase()}?`)) return;
      try {
        const res = await fetch(`/api/articles/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'No se pudo actualizar'));
        }
      } catch (e) {
        alert('Error de conexión');
      }
    }

    async function deleteArticleConfirm(id, title) {
      if (!confirm(`¿ELIMINAR DEFINITIVAMENTE el artículo "${title}"?`)) return;
      try {
        const res = await fetch(`/api/articles/${id}`, {
          method: 'DELETE',
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'No se pudo eliminar'));
        }
      } catch (e) {
        alert('Error de conexión');
      }
    }
  </script>
</Layout>
