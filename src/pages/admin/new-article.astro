---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser, canPublish } from '../../lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
if (!user || user.role === 'reader') {
  return Astro.redirect('/admin');
}

const isAdmin = canPublish(user);
---

<Layout title="Redactar Artículo | La Parte Arrendataria" maxWidth="max-w-[850px]">
  <div class="border-[3px] border-black bg-white p-6 shadow-[6px_6px_0px_#000]">
    <!-- Cabecera del formulario -->
    <div class="flex justify-between items-center border-b-2 border-black pb-3 mb-6 font-mono">
      <div>
        <span class="text-xs font-bold uppercase text-red-700 block">REDACCIÓN EDITORIAL</span>
        <h1 class="text-2xl font-black font-serif uppercase tracking-tight m-0">
          Nuevo Artículo
        </h1>
      </div>
      <a href="/admin" class="brutal-btn text-xs">← Volver al Panel</a>
    </div>

    <div id="alert-box" class="hidden mb-4 p-3 border-2 font-mono text-xs font-bold"></div>

    <form id="article-form" class="space-y-6 font-mono text-xs">
      <!-- 1. Título -->
      <div>
        <label class="block font-bold uppercase mb-1" for="title">
          1. Titular del Artículo <span class="text-red-700">*</span>:
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          placeholder="Ej: El corazón del decreto y la urgencia del contrato indefinido"
          class="w-full border-2 border-black p-2 text-sm font-serif font-bold bg-[#fafafa] focus:outline-none focus:ring-2 focus:ring-black"
        />
      </div>

      <!-- 2. Extracto del Artículo (Obligatorio para la portada) -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="font-bold uppercase" for="excerpt">
            2. Extracto del Artículo (Portada Web) <span class="text-red-700">*</span>:
          </label>
          <span class="text-gray-500 text-[10px]">Breve síntesis de 1-3 frases que se mostrará en el feed principal</span>
        </div>
        <textarea
          id="excerpt"
          name="excerpt"
          required
          rows="3"
          placeholder="Escribe aquí el extracto visible en la portada..."
          class="w-full border-2 border-black p-2 font-serif text-sm bg-[#fafafa] focus:outline-none focus:ring-2 focus:ring-black leading-relaxed"
        ></textarea>
      </div>

      <!-- 3. Fotografía Única (1 Foto Máx) -->
      <div class="border-2 border-black p-4 bg-gray-50">
        <div class="flex items-center justify-between mb-2">
          <label class="font-bold uppercase text-black" for="photoUrl">
            3. Fotografía Única (Restricción Estricta: 1 Foto Máximo)
          </label>
          <span class="bg-black text-white text-[10px] px-1.5 py-0.5 uppercase">Regla Editorial</span>
        </div>
        <input
          type="url"
          id="photoUrl"
          name="photoUrl"
          placeholder="https://ejemplo.org/imagen-manifestacion.jpg"
          class="w-full border-2 border-black p-2 bg-white mb-2"
        />
        <label class="block font-semibold text-gray-700 mb-1" for="photoCaption">
          Pie de Foto (Monoespaciado / Halftone):
        </label>
        <input
          type="text"
          id="photoCaption"
          name="photoCaption"
          placeholder="Ej: Vecinas concentradas en asamblea de barrio."
          class="w-full border border-gray-400 p-1.5 bg-white text-xs"
        />
        <p class="text-[10px] text-gray-500 mt-1">
          * En la web se renderizará con borde negro y sombra. En el PDF del fanzine se aplicará trama de fotocopiadora.
        </p>
      </div>

      <!-- 3. Audio Voice-Note (SpeakPipe API - Máx 2 Min) -->
      <div class="border-2 border-black p-4 bg-gray-50">
        <div class="flex items-center justify-between mb-2">
          <label class="font-bold uppercase text-black" for="speakPipeAudioUrl">
            3. Nota de Voz de Redacción (SpeakPipe API • Máx. 2 Minutos)
          </label>
          <a
            href="https://www.speakpipe.com/voice-recorder"
            target="_blank"
            rel="noopener noreferrer"
            class="text-red-700 underline font-bold text-[10px] hover:text-black"
          >
            Abrir Grabador SpeakPipe ↗
          </a>
        </div>
        <input
          type="url"
          id="speakPipeAudioUrl"
          name="speakPipeAudioUrl"
          placeholder="https://www.speakpipe.com/voice-recorder/embed/... o enlace de audio MP3"
          class="w-full border-2 border-black p-2 bg-white mb-1"
        />
        <p class="text-[10px] text-gray-500">
          Integra el widget o audio de SpeakPipe para que la versión digital cuente con la voz directa del redactor/activista.
        </p>
      </div>

      <!-- 4. Cuerpo en Markdown (Escribir o Subir Archivo) -->
      <div class="border-2 border-black p-4 bg-white">
        <div class="flex flex-wrap justify-between items-center mb-2 gap-2">
          <label class="font-bold uppercase text-black" for="content">
            4. Cuerpo del Artículo (Markdown) <span class="text-red-700">*</span>:
          </label>
          <span class="text-gray-500 text-[10px]">Soporta: **negrita**, # subtítulos, > citas</span>
        </div>

        <!-- Zona de Carga de Archivo Markdown -->
        <div
          id="drop-zone"
          class="border-2 border-dashed border-black bg-gray-50 hover:bg-yellow-50 p-4 mb-3 text-center cursor-pointer transition-colors relative"
        >
          <input
            type="file"
            id="md-file-input"
            accept=".md,.markdown,.txt"
            class="hidden"
          />
          <div class="flex flex-col items-center justify-center gap-1">
            <span class="text-xl">📁</span>
            <span class="font-bold text-black uppercase text-xs">
              Subir archivo Markdown (.md o .txt) o arrastrarlo aquí
            </span>
            <span class="text-[10px] text-gray-500">
              El contenido se cargará automáticamente en el campo de texto inferior para su revisión.
            </span>
          </div>
          <div id="file-loaded-info" class="hidden mt-2 p-1.5 bg-green-100 border border-green-800 text-green-900 font-bold text-[11px]"></div>
        </div>

        <!-- Ayuda rápida de caja destacada flotante -->
        <div class="flex flex-wrap items-center justify-between gap-2 p-2 mb-2 bg-yellow-100/80 border border-black text-[11px] font-mono">
          <div class="flex items-center gap-1">
            <span class="font-bold text-red-700">★ CAJA DESTACADA:</span>
            <span class="text-gray-800">Caja de texto destacado (web derecha / PDF intercalada):</span>
            <code class="bg-white px-1 border border-gray-400 font-bold">&gt; [!DESTACADO]</code>
          </div>
          <button
            type="button"
            id="insert-aside-btn"
            onclick="insertAsideSnippet()"
            class="underline font-bold text-black hover:text-red-700 cursor-pointer"
          >
            [+ Insertar caja de texto destacado]
          </button>
        </div>

        <!-- Editor de texto en Markdown -->
        <div class="relative">
          <textarea
            id="content"
            name="content"
            required
            rows="12"
            placeholder="Escribe aquí el texto en Markdown o cárgalo mediante el botón superior..."
            class="w-full border-2 border-black p-3 font-serif text-sm bg-white focus:outline-none focus:ring-2 focus:ring-black leading-relaxed"
          ></textarea>
        </div>
      </div>

      <!-- 5. Enlace a Fuente Original (Generará QR en PDF) -->
      <div class="border-2 border-black p-4 bg-yellow-50">
        <div class="flex items-center justify-between mb-1">
          <label class="font-bold uppercase text-black" for="sourceUrl">
            5. Enlace a Fuente Original (Autogenerará QR en PDF Fanzine)
          </label>
          <span class="bg-red-700 text-white text-[10px] px-1.5 py-0.5 uppercase">Exclusivo PDF</span>
        </div>
        <input
          type="url"
          id="sourceUrl"
          name="sourceUrl"
          placeholder="https://boe.es/... o https://elsaltodiario.com/..."
          class="w-full border-2 border-black p-2 bg-white"
        />
        <p class="text-[10px] text-gray-600 mt-1">
          * En el PDF físico aparecerá un código QR vectorial con el sello: <em>"ESCANEA PARA LEER FUENTE ORIGINAL"</em>.
        </p>
      </div>

      <!-- Barra de Botones / Acciones según Rol -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t-2 border-black">
        <div class="text-[11px] text-gray-600 font-bold uppercase">
          Autor: <span class="text-black">{user.displayName}</span> ({user.role})
        </div>

        <div class="flex gap-2">
          <!-- Guardar Borrador (disponible para Editor y Admin) -->
          <button
            type="button"
            onclick="submitArticle('draft')"
            class="brutal-btn bg-white hover:bg-gray-100"
          >
            💾 Guardar Borrador
          </button>

          <!-- Publicar Ahora (ADMIN ÚNICAMENTE) -->
          {isAdmin ? (
            <button
              type="button"
              onclick="submitArticle('published')"
              class="brutal-btn brutal-btn-primary"
            >
              🚀 Publicar Inmediatamente
            </button>
          ) : (
            <span class="text-[10px] text-gray-500 italic flex items-center">
              (Publicación reservada al Administrador)
            </span>
          )}
        </div>
      </div>
    </form>
  </div>

  <script is:inline>
    // Manejo de carga de archivo Markdown
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('md-file-input');
    const fileInfo = document.getElementById('file-loaded-info');
    const contentTextarea = document.getElementById('content');
    const titleInput = document.getElementById('title');

    if (dropZone && fileInput) {
      dropZone.addEventListener('click', () => fileInput.click());

      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('bg-yellow-200');
      });

      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('bg-yellow-200');
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('bg-yellow-200');
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
          processMarkdownFile(e.dataTransfer.files[0]);
        }
      });

      fileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files.length > 0) {
          processMarkdownFile(e.target.files[0]);
        }
      });
    }

    function insertAsideSnippet() {
      const snippet = `\n\n> [!DESTACADO]\n> Escribe aquí el texto o dato clave que quieres destacar en esta caja.\n\n`;
      const textarea = document.getElementById('content');
      if (textarea) {
        const start = textarea.selectionStart || textarea.value.length;
        const end = textarea.selectionEnd || textarea.value.length;
        const before = textarea.value.substring(0, start);
        const after = textarea.value.substring(end);
        textarea.value = before + snippet + after;
        textarea.focus();
        textarea.setSelectionRange(start + snippet.length, start + snippet.length);
      }
    }

    // Exponer a window y enlazar evento
    window.insertAsideSnippet = insertAsideSnippet;
    const insertAsideBtn = document.getElementById('insert-aside-btn');
    if (insertAsideBtn) {
      insertAsideBtn.addEventListener('click', insertAsideSnippet);
    }

    async function processMarkdownFile(file) {
      if (!file) return;
      try {
        const text = await file.text();
        contentTextarea.value = text;

        // Si el titular está vacío, sugerir primer H1 o nombre de archivo
        if (titleInput && !titleInput.value.trim()) {
          const match = text.match(/^#\s+(.+)$/m);
          if (match) {
            titleInput.value = match[1].trim();
          } else {
            const cleanName = file.name.replace(/\.(md|markdown|txt)$/i, '').replace(/[-_]/g, ' ');
            titleInput.value = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);
          }
        }

        // Si el extracto está vacío, sugerir el primer párrafo de texto limpio
        const excerptInput = document.getElementById('excerpt');
        if (excerptInput && !excerptInput.value.trim()) {
          const paragraphs = text.split('\n\n').map(p => p.trim()).filter(p => p && !p.startsWith('#'));
          if (paragraphs.length > 0) {
            excerptInput.value = paragraphs[0].replace(/[*_#`]/g, '').substring(0, 240);
          }
        }

        const sizeKb = (file.size / 1024).toFixed(1);
        fileInfo.innerText = `✓ Archivo cargado: "${file.name}" (${sizeKb} KB) — Contenido volcado en el editor.`;
        fileInfo.classList.remove('hidden');
      } catch (err) {
        alert('Error al leer el archivo markdown: ' + err.message);
      }
    }

    async function submitArticle(status) {
      const form = document.getElementById('article-form');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const alertBox = document.getElementById('alert-box');
      alertBox.classList.add('hidden');

      const payload = {
        title: document.getElementById('title').value,
        excerpt: document.getElementById('excerpt').value,
        content: document.getElementById('content').value,
        photoUrl: document.getElementById('photoUrl').value,
        photoCaption: document.getElementById('photoCaption').value,
        speakPipeAudioUrl: document.getElementById('speakPipeAudioUrl').value,
        sourceUrl: document.getElementById('sourceUrl').value,
        status: status,
      };

      try {
        const res = await fetch('/api/articles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alertBox.className = 'mb-4 p-3 border-2 border-green-700 bg-green-100 text-green-900 font-mono text-xs font-bold';
          alertBox.innerText = `Artículo guardado con éxito como ${status.toUpperCase()}. Redirigiendo...`;
          alertBox.classList.remove('hidden');
          setTimeout(() => {
            window.location.href = '/admin';
          }, 1000);
        } else {
          alertBox.className = 'mb-4 p-3 border-2 border-red-700 bg-red-100 text-red-900 font-mono text-xs font-bold';
          alertBox.innerText = data.error || 'Error al guardar el artículo.';
          alertBox.classList.remove('hidden');
        }
      } catch (e) {
        alertBox.className = 'mb-4 p-3 border-2 border-red-700 bg-red-100 text-red-900 font-mono text-xs font-bold';
        alertBox.innerText = 'Error de conexión con el servidor.';
        alertBox.classList.remove('hidden');
      }
    }
    window.submitArticle = submitArticle;
  </script>
</Layout>
