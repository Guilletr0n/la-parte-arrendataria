---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import Pagination from '../../components/Pagination.astro';
import { getCurrentUser, canManageUsers } from '../../lib/auth';
import { getArticles } from '../../lib/db';
import { getUsers } from '../../lib/users';

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/login');
}

const isUserAdmin = canManageUsers(user);

// Only administrators can manage users
if (!isUserAdmin) {
  return Astro.redirect('/admin');
}

const allUsers = await getUsers();
const allArticles = await getArticles();

// Count articles per author
const articleCountByAuthor = new Map<string, number>();
allArticles.forEach(a => {
  if (a.authorUid) {
    articleCountByAuthor.set(a.authorUid, (articleCountByAuthor.get(a.authorUid) || 0) + 1);
  }
});

// Role stats
const adminCount = allUsers.filter(u => u.role === 'admin').length;
const editorCount = allUsers.filter(u => u.role === 'editor').length;
const readerCount = allUsers.filter(u => u.role === 'reader').length;

// Pagination logic: max 20 users per page
const PAGE_SIZE = 20;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10));
const totalUsers = allUsers.length;
const totalPages = Math.ceil(totalUsers / PAGE_SIZE) || 1;
const paginatedUsers = allUsers.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<Layout title="Gestión de Usuarias | La Parte Arrendataria" maxWidth="max-w-[950px]">
  <!-- Top Bar: User info & Logout -->
  <div class="border-2 border-black bg-white p-3 mb-4 flex flex-wrap justify-between items-center font-mono text-xs shadow-[3px_3px_0px_#000]">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 font-bold uppercase text-white bg-red-700">
        ROL: {user.role.toUpperCase()}
      </span>
      <span class="font-bold text-black">{user.displayName}</span>
      <span class="text-gray-500">({user.email})</span>
    </div>
    <div class="flex items-center gap-3">
      <button
        type="button"
        onclick="document.getElementById('change-password-modal').showModal()"
        class="hover:underline font-bold text-black border border-black px-2 py-0.5 bg-yellow-200 hover:bg-yellow-300 transition-colors cursor-pointer"
      >
        🔑 Cambiar Contraseña
      </button>
      <a href="/" target="_blank" class="hover:underline font-bold text-black">Ver Web Pública ↗</a>
      <a href="/api/auth/logout" class="hover:underline text-red-700 font-bold">Cerrar Sesión [x]</a>
    </div>
  </div>

  <!-- Admin Navigation Tabs -->
  <AdminNav
    activeTab="users"
    articleCount={allArticles.length}
    userCount={allUsers.length}
    isUserAdmin={isUserAdmin}
  />

  <!-- SECCIÓN: Panel de Usuarias Autorizadas -->
  <div class="border-[3px] border-black bg-white shadow-[5px_5px_0px_#000] p-4 mb-8">
    <div class="flex flex-wrap justify-between items-center border-b-2 border-black pb-2 mb-4 font-mono gap-2">
      <div>
        <span class="text-[10px] font-bold uppercase text-red-700 block tracking-wider">
          CONTROL DE ACCESO Y ROLES
        </span>
        <h1 class="text-lg font-black uppercase tracking-tight m-0">
          Usuarias Autorizadas de la Asamblea
        </h1>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-black text-white px-2 py-0.5 text-xs font-bold">
          {totalUsers} usuarias
        </span>
        <button
          type="button"
          onclick="document.getElementById('create-user-modal').showModal()"
          class="brutal-btn text-xs bg-yellow-300 font-bold py-1 px-3"
        >
          + Nueva Usuaria
        </button>
      </div>
    </div>

    <!-- Resumen de Roles -->
    <div class="grid grid-cols-3 gap-2 mb-4 font-mono text-xs">
      <div class="border border-black p-2 bg-red-50">
        <span class="text-gray-600 block text-[10px] uppercase font-bold">Admins</span>
        <span class="text-lg font-black text-red-700">{adminCount}</span>
      </div>
      <div class="border border-black p-2 bg-blue-50">
        <span class="text-gray-600 block text-[10px] uppercase font-bold">Editoras</span>
        <span class="text-lg font-black text-blue-800">{editorCount}</span>
      </div>
      <div class="border border-black p-2 bg-yellow-50">
        <span class="text-gray-600 block text-[10px] uppercase font-bold">Aspirantes (Pendientes)</span>
        <span class="text-lg font-black text-yellow-800">{readerCount}</span>
      </div>
    </div>

    <!-- Tabla de Usuarias -->
    <div class="overflow-x-auto">
      <table class="w-full text-left font-mono text-xs border-collapse">
        <thead>
          <tr class="border-b-2 border-black bg-gray-100 uppercase">
            <th class="p-2">Firma Pública</th>
            <th class="p-2">Email</th>
            <th class="p-2">Rol Asignado</th>
            <th class="p-2">Artículos</th>
            <th class="p-2 text-right">Gestión</th>
          </tr>
        </thead>
        <tbody>
          {paginatedUsers.map((u) => {
            const authoredCount = articleCountByAuthor.get(u.uid) || 0;
            return (
              <tr class="border-b border-gray-300 hover:bg-yellow-50 cursor-pointer" onclick={`openManageUserModal(${JSON.stringify(u)}, ${authoredCount})`}>
                <!-- Nombre -->
                <td class="p-2 font-bold text-black">
                  {u.displayName}
                  {u.uid === user.uid && (
                    <span class="text-[10px] text-gray-500 font-normal ml-1">(Tú)</span>
                  )}
                </td>

                <!-- Email -->
                <td class="p-2 text-gray-700">
                  {u.email}
                </td>

                <!-- Rol -->
                <td class="p-2 whitespace-nowrap">
                  {u.role === 'admin' && (
                    <span class="bg-red-700 text-white font-bold px-2 py-0.5 text-[10px]">
                      ADMINISTRADORA
                    </span>
                  )}
                  {u.role === 'editor' && (
                    <span class="bg-blue-800 text-white font-bold px-2 py-0.5 text-[10px]">
                      EDITORA
                    </span>
                  )}
                  {u.role === 'reader' && (
                    <span class="bg-yellow-200 text-yellow-900 border border-yellow-700 font-bold px-2 py-0.5 text-[10px] inline-flex items-center gap-1">
                      <span>⏳</span>
                      <span>ASPIRANTE (Pendiente)</span>
                    </span>
                  )}
                </td>

                <!-- Artículos -->
                <td class="p-2 whitespace-nowrap">
                  <span class="font-bold">{authoredCount}</span>
                </td>

                <!-- Acciones -->
                <td class="p-2 text-right space-x-1" onclick="event.stopPropagation()">
                  {u.role === 'reader' && (
                    <button
                      type="button"
                      onclick={`approveAsEditor('${u.uid}', '${u.displayName}')`}
                      class="brutal-btn bg-yellow-300 hover:bg-yellow-400 text-black text-xs py-1 px-2.5 font-bold inline-flex items-center gap-1 shadow-[2px_2px_0px_#000]"
                      title="Aprobar inmediatamente como Editora"
                    >
                      <span>★</span>
                      <span>Aprobar Editora</span>
                    </button>
                  )}
                  <button
                    type="button"
                    onclick={`openManageUserModal(${JSON.stringify(u)}, ${authoredCount})`}
                    class="brutal-btn text-xs py-1 px-2.5 font-bold"
                  >
                    ⚙️ Gestionar
                  </button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Paginación de Usuarias -->
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      totalItems={totalUsers}
      itemLabel="usuarias"
      baseUrl="/admin/users"
    />
  </div>

  <!-- MODAL: GESTIÓN DE USUARIA -->
  <dialog
    id="user-manage-modal"
    class="fixed inset-0 m-auto p-0 border-4 border-black bg-white shadow-[8px_8px_0px_#000] max-w-lg w-[92%] backdrop:bg-black/75 z-50 overflow-hidden font-mono"
  >
    <div class="p-6 text-black">
      <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 block">
            GESTIÓN DE USUARIA AUTORIZADA
          </span>
          <h3 id="modal-user-title" class="font-sans text-xl font-black uppercase text-black m-0 truncate max-w-[340px]">
            Editar Usuaria
          </h3>
        </div>
        <button
          type="button"
          onclick="document.getElementById('user-manage-modal').close()"
          class="font-black text-lg hover:bg-black hover:text-white px-2 py-0.5 border border-black transition-colors"
        >
          ✕
        </button>
      </div>

      <div id="modal-alert" class="hidden mb-4 p-2 text-xs font-bold border-2"></div>

      <form id="manage-user-form" class="space-y-4 text-xs">
        <input type="hidden" id="edit-user-uid" />

        <!-- 1. Nombre / Firma -->
        <div>
          <label class="block font-bold uppercase mb-1" for="edit-user-name">
            Nombre / Firma pública:
          </label>
          <input
            type="text"
            id="edit-user-name"
            required
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <!-- 2. Email -->
        <div>
          <label class="block font-bold uppercase mb-1" for="edit-user-email">
            Correo Electrónico:
          </label>
          <input
            type="email"
            id="edit-user-email"
            required
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <!-- 3. Rol -->
        <div>
          <label class="block font-bold uppercase mb-1" for="edit-user-role">
            Rol y Permisos en el Sistema:
          </label>
          <select
            id="edit-user-role"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none font-bold"
          >
            <option value="editor">EDITORA (Redacción — Subir y editar sus propios artículos)</option>
            <option value="admin">ADMIN (Comité Editorial — Publicar, borrar, usuarios y fanzine)</option>
            <option value="reader">ASPIRANTE (Pendiente de asignación — Sin permisos de subida)</option>
          </select>
        </div>

        <!-- 4. Contraseña (Opcional) -->
        <div>
          <label class="block font-bold uppercase mb-1" for="edit-user-pass">
            Nueva Contraseña (Opcional):
          </label>
          <input
            type="password"
            id="edit-user-pass"
            minlength="6"
            placeholder="Dejar en blanco para mantener la actual"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <!-- Botón Rápido: Dejar sin permisos de editora -->
        <div class="pt-1">
          <button
            type="button"
            onclick="setRoleToReader()"
            class="w-full py-1.5 px-2 border-2 border-dashed border-gray-500 hover:border-black bg-gray-100 hover:bg-yellow-200 text-left font-bold text-[11px] transition-colors flex items-center justify-between"
          >
            <span>🛑 Dejar como Aspirante pendiente (Retirar permisos de editora)</span>
            <span class="text-[10px] text-gray-600">Asignar 'reader'</span>
          </button>
        </div>

        <!-- Artículos advertencia de reasignación -->
        <div id="modal-articles-warning" class="p-2.5 bg-yellow-50 border border-black text-[11px] text-gray-800 hidden">
          Esta usuaria tiene <strong id="modal-articles-count">0</strong> artículos redactados.
          Si eliminas la usuaria, todos sus artículos se <strong>reasignarán automáticamente al Comité Editorial (Admin)</strong>.
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t-2 border-black">
          <button
            type="button"
            id="delete-user-btn"
            onclick="handleDeleteUser()"
            class="brutal-btn bg-red-100 hover:bg-red-700 hover:text-white text-red-900 text-xs font-bold"
          >
            🗑️ Eliminar Usuaria
          </button>

          <div class="flex gap-2">
            <button
              type="button"
              onclick="document.getElementById('user-manage-modal').close()"
              class="brutal-btn bg-white hover:bg-gray-100 text-xs"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="save-user-btn"
              class="brutal-btn brutal-btn-primary text-xs font-bold"
            >
              Guardar Cambios
            </button>
          </div>
        </div>
      </form>
    </div>
  </dialog>

  <!-- MODAL: ALTA DE NUEVA USUARIA -->
  <dialog
    id="create-user-modal"
    class="fixed inset-0 m-auto p-0 border-4 border-black bg-white shadow-[8px_8px_0px_#000] max-w-lg w-[92%] backdrop:bg-black/75 z-50 overflow-hidden font-mono"
  >
    <div class="p-6 text-black">
      <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 block">
            REGISTRO DE COLABORADORA
          </span>
          <h3 class="font-sans text-xl font-black uppercase text-black m-0">
            Añadir Nueva Usuaria
          </h3>
        </div>
        <button
          type="button"
          onclick="document.getElementById('create-user-modal').close()"
          class="font-black text-lg hover:bg-black hover:text-white px-2 py-0.5 border border-black transition-colors"
        >
          ✕
        </button>
      </div>

      <div id="create-modal-alert" class="hidden mb-4 p-2 text-xs font-bold border-2"></div>

      <form id="create-user-form" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold uppercase mb-1" for="new-user-name">
            Nombre / Firma pública:
          </label>
          <input
            type="text"
            id="new-user-name"
            required
            placeholder="Ej: Inquilina Vallecas, Laura P."
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="new-user-email">
            Correo Electrónico:
          </label>
          <input
            type="email"
            id="new-user-email"
            required
            placeholder="colaboradora@asamblea.org"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="new-user-pass">
            Contraseña Inicial:
          </label>
          <input
            type="password"
            id="new-user-pass"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="new-user-role">
            Rol Asignado:
          </label>
          <select
            id="new-user-role"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none font-bold"
          >
            <option value="editor" selected>EDITORA (Redacción — Subir y editar sus propios artículos)</option>
            <option value="admin">ADMIN (Comité Editorial — Control total)</option>
            <option value="reader">ASPIRANTE (Pendiente de asignación de rol)</option>
          </select>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t-2 border-black">
          <button
            type="button"
            onclick="document.getElementById('create-user-modal').close()"
            class="brutal-btn bg-white hover:bg-gray-100 text-xs"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="create-submit-btn"
            class="brutal-btn brutal-btn-primary text-xs font-bold"
          >
            + Crear Usuaria
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- MODAL: CAMBIAR CONTRASEÑA -->
  <dialog
    id="change-password-modal"
    class="fixed inset-0 m-auto p-0 border-4 border-black bg-white shadow-[8px_8px_0px_#000] max-w-md w-[92%] backdrop:bg-black/75 z-50 overflow-hidden font-mono"
  >
    <div class="p-6 text-black">
      <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 block">
            SEGURIDAD DE LA CUENTA
          </span>
          <h3 class="font-sans text-xl font-black uppercase text-black m-0">
            Cambiar Contraseña
          </h3>
        </div>
        <button
          type="button"
          onclick="document.getElementById('change-password-modal').close()"
          class="font-black text-lg hover:bg-black hover:text-white px-2 py-0.5 border border-black transition-colors"
        >
          ✕
        </button>
      </div>

      <div id="change-pass-alert" class="hidden mb-4 p-2 text-xs font-bold border-2"></div>

      <form id="change-password-form" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold uppercase mb-1" for="current-password">
            Contraseña Actual:
          </label>
          <input
            type="password"
            id="current-password"
            required
            placeholder="Introduce tu contraseña actual"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="new-password">
            Nueva Contraseña (mínimo 6 caracteres):
          </label>
          <input
            type="password"
            id="new-password"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div>
          <label class="block font-bold uppercase mb-1" for="confirm-new-password">
            Repite la Nueva Contraseña:
          </label>
          <input
            type="password"
            id="confirm-new-password"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full border-2 border-black p-2 bg-[#fdfdfd] focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t-2 border-black">
          <button
            type="button"
            onclick="document.getElementById('change-password-modal').close()"
            class="brutal-btn bg-white hover:bg-gray-100 text-xs"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="change-pass-submit-btn"
            class="brutal-btn brutal-btn-primary text-xs font-bold"
          >
            Actualizar Contraseña
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <script is:inline>
    let currentSelectedUser = null;

    function openManageUserModal(userData, articleCount) {
      currentSelectedUser = userData;
      const modal = document.getElementById('user-manage-modal');
      const title = document.getElementById('modal-user-title');
      const uidInput = document.getElementById('edit-user-uid');
      const nameInput = document.getElementById('edit-user-name');
      const emailInput = document.getElementById('edit-user-email');
      const roleSelect = document.getElementById('edit-user-role');
      const alertBox = document.getElementById('modal-alert');
      const warningBox = document.getElementById('modal-articles-warning');
      const countSpan = document.getElementById('modal-articles-count');

      alertBox.classList.add('hidden');
      title.textContent = userData.displayName;
      uidInput.value = userData.uid;
      nameInput.value = userData.displayName;
      emailInput.value = userData.email;
      roleSelect.value = userData.role;
      const passInput = document.getElementById('edit-user-pass');
      if (passInput) passInput.value = '';

      if (articleCount > 0) {
        countSpan.textContent = articleCount;
        warningBox.classList.remove('hidden');
      } else {
        warningBox.classList.add('hidden');
      }

      modal.showModal();
    }

    async function approveAsEditor(uid, name) {
      if (!confirm(`¿Asignar rol de EDITORA a "${name}" para permitirle redactar y subir artículos?`)) return;
      try {
        const res = await fetch(`/api/users/${uid}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'editor' }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'No se pudo asignar el rol de editora'));
        }
      } catch (e) {
        alert('Error de conexión con el servidor.');
      }
    }

    function setRoleToReader() {
      const roleSelect = document.getElementById('edit-user-role');
      roleSelect.value = 'reader';
      const alertBox = document.getElementById('modal-alert');
      alertBox.textContent = "Rol cambiado a 'Aspirante pendiente (Sin permisos de redacción)'. Guarda los cambios para aplicar.";
      alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-yellow-100 border-yellow-700 text-yellow-900';
      alertBox.classList.remove('hidden');
    }

    // Save User Updates
    document.getElementById('manage-user-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const uid = document.getElementById('edit-user-uid').value;
      const displayName = document.getElementById('edit-user-name').value.trim();
      const email = document.getElementById('edit-user-email').value.trim();
      const role = document.getElementById('edit-user-role').value;
      const pass = document.getElementById('edit-user-pass')?.value;
      const saveBtn = document.getElementById('save-user-btn');
      const alertBox = document.getElementById('modal-alert');

      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';

      const payload = { displayName, email, role };
      if (pass && pass.trim()) {
        payload.password = pass.trim();
      }

      try {
        const res = await fetch(`/api/users/${uid}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok) {
          alertBox.textContent = '¡Usuaria actualizada con éxito!';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-green-100 border-green-700 text-green-900';
          alertBox.classList.remove('hidden');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          alertBox.textContent = data.error || 'Error al actualizar usuaria';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
          alertBox.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Guardar Cambios';
        }
      } catch (err) {
        alertBox.textContent = 'Error de conexión con el servidor.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Guardar Cambios';
      }
    });

    // Delete User
    async function handleDeleteUser() {
      if (!currentSelectedUser) return;
      const uid = currentSelectedUser.uid;
      const name = currentSelectedUser.displayName;

      const confirmed = confirm(
        `¿Estás SEGURA de eliminar la cuenta de "${name}"?\n\nSus artículos NO se borrarán: serán reasignados automáticamente a tu cuenta de Administradora.`
      );
      if (!confirmed) return;

      const deleteBtn = document.getElementById('delete-user-btn');
      const alertBox = document.getElementById('modal-alert');
      deleteBtn.disabled = true;
      deleteBtn.textContent = 'Eliminando y reasignando...';

      try {
        const res = await fetch(`/api/users/${uid}`, {
          method: 'DELETE',
        });

        const data = await res.json();
        if (res.ok) {
          alertBox.textContent = data.message || 'Usuaria eliminada y artículos reasignados.';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-green-100 border-green-700 text-green-900';
          alertBox.classList.remove('hidden');
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        } else {
          alertBox.textContent = data.error || 'No se pudo eliminar la usuaria';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
          alertBox.classList.remove('hidden');
          deleteBtn.disabled = false;
          deleteBtn.textContent = '🗑️ Eliminar Usuaria';
        }
      } catch (err) {
        alertBox.textContent = 'Error de conexión con el servidor.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        deleteBtn.disabled = false;
        deleteBtn.textContent = '🗑️ Eliminar Usuaria';
      }
    }

    // Create New User by Admin
    document.getElementById('create-user-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const displayName = document.getElementById('new-user-name').value.trim();
      const email = document.getElementById('new-user-email').value.trim();
      const password = document.getElementById('new-user-pass').value;
      const role = document.getElementById('new-user-role').value;
      const submitBtn = document.getElementById('create-submit-btn');
      const alertBox = document.getElementById('create-modal-alert');

      submitBtn.disabled = true;
      submitBtn.textContent = 'Creando...';

      try {
        const res = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ displayName, email, password, role }),
        });

        const data = await res.json();
        if (res.ok) {
          alertBox.textContent = '¡Usuaria creada con éxito!';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-green-100 border-green-700 text-green-900';
          alertBox.classList.remove('hidden');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          alertBox.textContent = data.error || 'Error al crear usuaria';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
          alertBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = '+ Crear Usuaria';
        }
      } catch (err) {
        alertBox.textContent = 'Error de conexión con el servidor.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = '+ Crear Usuaria';
      }
    });

    // Change Password Form
    document.getElementById('change-password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const currentPassword = document.getElementById('current-password').value;
      const newPassword = document.getElementById('new-password').value;
      const confirmPassword = document.getElementById('confirm-new-password').value;
      const submitBtn = document.getElementById('change-pass-submit-btn');
      const alertBox = document.getElementById('change-pass-alert');

      if (newPassword !== confirmPassword) {
        alertBox.textContent = 'Las contraseñas no coinciden.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Actualizando...';

      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword, confirmPassword }),
        });

        const data = await res.json();
        if (res.ok) {
          alertBox.textContent = '¡Contraseña actualizada con éxito!';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-green-100 border-green-700 text-green-900';
          alertBox.classList.remove('hidden');
          setTimeout(() => {
            document.getElementById('change-password-modal').close();
            document.getElementById('change-password-form').reset();
            alertBox.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Actualizar Contraseña';
          }, 1500);
        } else {
          alertBox.textContent = data.error || 'Error al cambiar la contraseña';
          alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
          alertBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Actualizar Contraseña';
        }
      } catch (err) {
        alertBox.textContent = 'Error de conexión con el servidor.';
        alertBox.className = 'mb-4 p-2 text-xs font-bold border-2 bg-red-100 border-red-700 text-red-900';
        alertBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Actualizar Contraseña';
      }
    });
  </script>
</Layout>
