---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/db';

export const prerender = false;

const articles = await getArticles({ status: 'published', sortBy: 'blended' });
---

<Layout title="La Parte Arrendataria — Periódico de Guerrilla Inquilina">
  <!-- Cabecera de Publicación: enmarcada en 720px en la Web -->
  <Header />

  <!-- Manifiesto Rápido Guerrilla -->
  <div class="border-2 border-black bg-white p-3 mb-6 shadow-[4px_4px_0px_#000] text-xs font-mono">
    <div class="flex items-center justify-between mb-1">
      <span class="font-bold uppercase tracking-wider text-red-700">★ AVISO A LA COMUNIDAD ARRENDATARIA</span>
      <span class="bg-black text-white px-1.5 py-0.5 text-[10px]">EDICIÓN DIGITAL</span>
    </div>
    <p class="text-gray-800 leading-normal">
      Este fanzine se compone de notas de voz de 2 minutos, análisis de urgencia y una selección editorial lista para ser fotocopiada a 3 columnas. Cada artículo contiene un código QR a la fuente original para verificación pública.
    </p>
  </div>

  <!-- Barra de Sindicación Popular y Criterio de Ordenación con Filtro -->
  <div class="border-b-2 border-black pb-3 mb-6 font-mono text-xs space-y-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="bg-black text-white font-bold px-1.5 py-0.5 text-[10px] rounded">SINDICACIÓN</span>
        <span class="font-bold text-black uppercase tracking-tight">Artículos Sindicados</span>
      </div>
      <div class="text-[11px] text-gray-600 flex items-center gap-1.5">
        <span class="text-black font-bold">✊🏼 Puño en alto</span>
        <span class="text-gray-400">|</span>
        <span>Ordenados por votos y fecha</span>
      </div>
    </div>

    <!-- Filtro de Contenidos (Prensa escrita vs Notas de audio) -->
    <div class="flex flex-wrap items-center gap-2 pt-1">
      <span class="text-[11px] font-bold text-gray-600 uppercase">Filtrar:</span>
      <button
        type="button"
        id="filter-all"
        class="filter-tab-btn active px-2.5 py-1 text-[11px] font-bold border-2 border-black bg-black text-white cursor-pointer rounded-lg shadow-[2px_2px_0px_#000] transition-colors"
        data-filter="all"
      >
        ★ Todo ({articles.length})
      </button>
      <button
        type="button"
        id="filter-text"
        class="filter-tab-btn px-2.5 py-1 text-[11px] font-bold border-2 border-black bg-white text-black hover:bg-yellow-100 cursor-pointer rounded-lg shadow-[2px_2px_0px_#000] transition-colors"
        data-filter="text"
      >
        📄 Quitar notas de audio (Solo prensa)
      </button>
      <button
        type="button"
        id="filter-audio"
        class="filter-tab-btn px-2.5 py-1 text-[11px] font-bold border-2 border-black bg-white text-black hover:bg-yellow-100 cursor-pointer rounded-lg shadow-[2px_2px_0px_#000] transition-colors"
        data-filter="audio"
      >
        🎙️ Solo notas de audio
      </button>
    </div>
  </div>

  <!-- Feed de Artículos Sindicados -->
  <section class="space-y-2">
    {articles.length === 0 ? (
      <div class="border-2 border-dashed border-black p-8 text-center font-mono">
        <p class="text-lg font-bold uppercase mb-2">No hay artículos publicados todavía</p>
        <p class="text-sm text-gray-600 mb-4">Accede al panel de administración para redactar el primer número.</p>
        <a href="/admin/login" class="brutal-btn brutal-btn-primary">Entrar al CMS</a>
      </div>
    ) : (
      articles.map(article => (
        <ArticleCard article={article} isExcerptOnly={true} />
      ))
    )}
  </section>

  <!-- Banner para Imprimir Fanzine Físico -->
  <div class="my-10 border-4 border-black p-6 bg-yellow-300 shadow-[6px_6px_0px_#000] text-center font-mono">
    <h3 class="text-xl font-black uppercase tracking-tight mb-2">
      ¿Quieres la edición física en papel?
    </h3>
    <p class="text-xs sm:text-sm text-black mb-4">
      Maquetación profesional a 3 columnas optimizada para fotocopiadoras de barrio con QR impresos.
    </p>
    <a href="/admin/export-fanzine" class="brutal-btn brutal-btn-primary text-sm">
      Ir al Selector & Descarga de PDF Fanzine →
    </a>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('.editorial-article');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        filterBtns.forEach(b => {
          b.classList.remove('bg-black', 'text-white', 'active');
          b.classList.add('bg-white', 'text-black');
        });
        btn.classList.add('bg-black', 'text-white', 'active');
        btn.classList.remove('bg-white', 'text-black');

        cards.forEach(card => {
          const isAudio = card.getAttribute('data-is-audio') === 'true';
          if (filter === 'text') {
            // Quitar notas de audio (solo artículos de prensa)
            card.style.display = isAudio ? 'none' : '';
          } else if (filter === 'audio') {
            // Solo notas de audio
            card.style.display = isAudio ? '' : 'none';
          } else {
            // Mostrar todos los contenidos
            card.style.display = '';
          }
        });
      });
    });
  });
</script>
