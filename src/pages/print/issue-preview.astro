---
import Header from '../../components/Header.astro';
import { getArticles } from '../../lib/db';
import { generateQrDataUrl, getArticleQrTargetUrl, getSiteUrl, getDomain } from '../../lib/qr';
import { renderArticleMarkdown } from '../../lib/markdown';
import '../../styles/global.css';

export const prerender = false;

// 1. Obtener artículos seleccionados para el fanzine (o fallback a publicados)
let allSelected = await getArticles({ selectedForPrint: true });
if (allSelected.length === 0) {
  allSelected = await getArticles({ status: 'published' });
}

// Ordenar por printOrder ascendente
allSelected.sort((a, b) => (a.printOrder || 1) - (b.printOrder || 1));

// 2. Clasificar en las 3 categorías requeridas: Destacado, Portada, Interior
let destacadoArticles = allSelected.filter(a => a.fanzineCategory === 'destacado');
let portadaArticles = allSelected.filter(a => a.fanzineCategory === 'portada');
let interiorArticles = allSelected.filter(a => a.fanzineCategory === 'interior' || a.includeInInterior);

// Si no se asignó un Destacado explícito:
if (destacadoArticles.length === 0 && allSelected.length > 0) {
  const candidate = allSelected.find(a => !portadaArticles.some(p => p.id === a.id));
  if (candidate) {
    destacadoArticles = [candidate];
  } else if (portadaArticles.length > 0) {
    destacadoArticles = [portadaArticles[0]];
    portadaArticles = portadaArticles.slice(1);
  } else {
    destacadoArticles = [allSelected[0]];
  }
}

// Fallback para portada cuando no hay selección previa:
if (portadaArticles.length === 0 && allSelected.length > 1) {
  portadaArticles = allSelected.filter(a => a.id !== destacadoArticles[0]?.id).slice(0, 3);
}

// Fallback para interior si no hay ninguno marcado:
if (interiorArticles.length === 0) {
  const coveredIds = new Set([...destacadoArticles.map(a => a.id), ...portadaArticles.map(a => a.id)]);
  interiorArticles = allSelected.filter(a => !coveredIds.has(a.id));
  if (interiorArticles.length === 0) {
    interiorArticles = allSelected;
  }
}

const siteUrl = getSiteUrl();
const siteDomain = getDomain();

// Generar códigos QR para TODOS los artículos seleccionados:
// Si tiene sourceUrl se usa esa fuente original; si no, se genera QR hacia la versión digital en ${siteUrl}/articulo/${art.slug}
const qrMap = new Map<string, string>();
const targetUrlMap = new Map<string, string>();

for (const art of allSelected) {
  const targetUrl = getArticleQrTargetUrl(art);
  targetUrlMap.set(art.id, targetUrl);
  const qr = await generateQrDataUrl(targetUrl);
  qrMap.set(art.id, qr);
}

const mainDestacado = destacadoArticles[0];

// Serializar datos de artículos interiores para paginación precisa cliente/Puppeteer
const interiorArticlesData = interiorArticles.map(art => {
  const htmlContent = renderArticleMarkdown(art.content || '');
  const formattedDate = new Date(art.createdAt).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
  const effectiveUrl = targetUrlMap.get(art.id) || getArticleQrTargetUrl(art);
  return {
    id: art.id,
    title: art.title,
    author: art.author,
    authorRole: art.authorRole || 'Redacción',
    date: formattedDate,
    photoUrl: art.photoUrl || null,
    photoCaption: art.photoCaption || null,
    sourceUrl: art.sourceUrl || null,
    effectiveUrl: effectiveUrl,
    hasExternalSource: Boolean(art.sourceUrl && art.sourceUrl.trim().length > 0),
    qrDataUrl: qrMap.get(art.id) || null,
    htmlContent: htmlContent,
  };
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>La Parte Arrendataria — Fanzine Folleto A4 Apaisado</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ======================================================== */
      /* REGLAS GLOBALES Y PANTALLA                               */
      /* ======================================================== */
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #383838;
        color: #000000;
        font-family: 'Playfair Display', Georgia, serif;
      }

      /* Hojas A4 Apaisadas Físicas (297mm ancho x 210mm alto) */
      .sheet-a4-landscape {
        width: 297mm;
        height: 210mm;
        min-height: 210mm;
        max-height: 210mm;
        background: #ffffff;
        margin: 0 auto 30px auto;
        display: flex;
        flex-direction: row;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5);
      }

      /* Guía central de plegado a los 148.5 mm */
      .sheet-fold-guide {
        position: absolute;
        left: 148.5mm;
        top: 0;
        bottom: 0;
        width: 0px;
        border-left: 1px dashed rgba(0, 0, 0, 0.28);
        z-index: 50;
        pointer-events: none;
      }

      /* Cada media hoja A4 (Página A5: 148.5mm x 210mm) */
      .half-page {
        width: 148.5mm;
        height: 210mm;
        min-height: 210mm;
        max-height: 210mm;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #ffffff;
      }

      /* Márgenes asimétricos para respetar el lomo/plegado central (10mm en el lomo) */
      .half-page-left {
        padding: 7mm 10mm 7mm 8mm; /* Lomo a la derecha */
      }

      .half-page-right {
        padding: 7mm 8mm 7mm 10mm; /* Lomo a la izquierda */
      }

      /* ======================================================== */
      /* CABECERAS Y PIES DE PÁGINA INTERIORES                     */
      /* ======================================================== */
      .interior-page-header {
        height: 7mm;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Space Mono', monospace;
        font-size: 7.5pt;
        text-transform: uppercase;
        font-weight: bold;
        border-bottom: 1.5px solid #000000;
        margin-bottom: 2.5mm;
        padding-bottom: 1mm;
        flex-shrink: 0;
      }

      /* Contenedor de flujo editorial a 2 columnas para cada página A5 */
      .interior-page-content {
        width: 130.5mm;
        height: 184mm;
        column-count: 2;
        column-gap: 5mm;
        column-rule: 1px solid #111111;
        column-fill: auto;
        overflow: hidden;
        text-align: justify;
        text-justify: inter-word;
        hyphens: auto;
        font-size: 8pt;
        line-height: 1.32;
        color: #111111;
      }

      /* Estilos para el texto de los artículos en columnas */
      .interior-page-content p {
        margin: 0 0 5px 0 !important;
        font-size: 8pt !important;
        line-height: 1.32 !important;
        text-align: justify !important;
        text-justify: inter-word !important;
        hyphens: auto !important;
        word-spacing: normal !important;
      }

      .interior-page-content h1,
      .interior-page-content h2,
      .interior-page-content h3,
      .interior-page-content h4,
      .interior-page-content h2.article-title {
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 9.5pt !important;
        font-weight: 900 !important;
        text-transform: uppercase !important;
        line-height: 1.15 !important;
        margin: 5px 0 3px 0 !important;
        text-align: left !important;
        text-wrap: balance !important;
        word-spacing: normal !important;
        break-after: avoid !important;
      }

      .fanzine-article-header {
        break-inside: avoid !important;
        break-after: avoid !important;
        margin-bottom: 4px !important;
      }

      .fanzine-article-header .meta-row {
        font-family: 'Space Mono', monospace;
        font-size: 6.5pt;
        text-transform: uppercase;
        color: #444444;
        display: flex;
        align-items: center;
        gap: 3px;
        margin-bottom: 1px;
      }

      .role-badge {
        background: #000000;
        color: #ffffff;
        font-weight: bold;
        padding: 0.5px 2.5px;
        font-size: 6pt;
      }

      /* Despieces asides en interior */
      .interior-page-content .editorial-aside {
        float: none !important;
        width: 100% !important;
        clear: both !important;
        box-sizing: border-box !important;
        border-left: 2.5px solid #000000 !important;
        background: #f4f4f4 !important;
        padding: 3px 5px !important;
        margin: 5px 0 !important;
        break-inside: avoid !important;
        font-size: 7.75pt !important;
        line-height: 1.28 !important;
        text-align: left !important;
      }

      .interior-page-content .editorial-aside p {
        font-size: 7.75pt !important;
        line-height: 1.28 !important;
        margin: 0 !important;
        text-align: left !important;
      }

      /* Fotografías en interior */
      .article-photo-block {
        margin: 4px 0 !important;
        break-inside: avoid !important;
      }

      .article-photo-block img {
        width: 100%;
        height: 38mm !important;
        max-height: 38mm !important;
        object-fit: cover;
        border: 1.5px solid #000000;
        display: block;
      }

      .article-photo-block figcaption {
        font-family: 'Space Mono', monospace;
        font-size: 6pt;
        color: #444;
        margin-top: 1px;
        font-style: italic;
      }

      /* Separador entre artículos continuos */
      .fanzine-article-separator {
        border-top: 1.5px dashed #444444;
        margin: 8px 0 6px 0;
        break-inside: avoid;
      }

      /* QR Normal al finalizar artículo completo */
      .article-qr-normal {
        display: flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #000000;
        padding: 3px;
        background: #fafafa;
        margin: 5px 0;
        break-inside: avoid;
      }

      .article-qr-normal img {
        width: 13mm;
        height: 13mm;
        border: 1px solid #000;
        flex-shrink: 0;
      }

      .article-qr-normal .qr-normal-text {
        font-family: 'Space Mono', monospace;
        font-size: 6pt;
        text-transform: uppercase;
        line-height: 1.15;
      }

      .article-qr-normal .qr-normal-title {
        font-weight: bold;
        display: block;
      }

      .article-qr-normal .qr-normal-url {
        color: #555;
        word-break: break-all;
      }

      /* ======================================================== */
      /* REQUISITO 2: CORTE DE ARTÍCULO Y QR FINAL                */
      /* ======================================================== */
      .cutoff-qr-block {
        width: 100% !important;
        box-sizing: border-box !important;
        clear: both !important;
        border: 2px solid #000000;
        background: #fffbe6;
        padding: 4px;
        margin: 5px 0 0 0;
        break-inside: avoid;
        box-shadow: 2px 2px 0px #000000;
      }

      .cutoff-bar {
        background: #000000;
        color: #ffffff;
        font-family: 'Space Mono', monospace;
        font-size: 6.5pt;
        font-weight: bold;
        text-align: center;
        text-transform: uppercase;
        padding: 1.5px 0;
        margin-bottom: 3px;
      }

      .cutoff-flex {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .cutoff-qr-img {
        width: 17mm;
        height: 17mm;
        border: 1.5px solid #000000;
        flex-shrink: 0;
        background: #ffffff;
      }

      .cutoff-meta {
        font-family: 'Space Mono', monospace;
        font-size: 6.5pt;
        text-transform: uppercase;
        line-height: 1.2;
      }

      .cutoff-meta .cutoff-title {
        font-weight: 900;
        color: #000000;
        display: block;
        margin-bottom: 1.5px;
      }

      .cutoff-meta .cutoff-url {
        color: #444444;
        word-break: break-all;
        font-size: 6pt;
        display: block;
      }

      /* ======================================================== */
      /* PÁGINA 1: PORTADA EN FORMATO A5 (148.5mm x 210mm)        */
      /* ======================================================== */
      .portada-a5-container {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        width: 100%;
      }

      .portada-header-compact {
        border-bottom: 2px solid #000000;
        padding-bottom: 2mm;
        margin-bottom: 2mm;
      }

      .portada-header-top-meta {
        display: flex;
        justify-content: space-between;
        font-family: 'Space Mono', monospace;
        font-size: 6.5pt;
        font-weight: bold;
        text-transform: uppercase;
        border-bottom: 1px solid #000;
        padding-bottom: 1px;
        margin-bottom: 2px;
      }

      .portada-title-box {
        text-align: center;
        padding: 1px 0;
      }

      .portada-title-sub {
        font-family: 'Space Mono', monospace;
        font-size: 8pt;
        letter-spacing: 0.22em;
        font-weight: bold;
        text-transform: uppercase;
        margin: 0;
      }

      .portada-title-main {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 20pt;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        line-height: 0.95;
        border: 2.5px solid #000;
        display: inline-block;
        padding: 1px 12px;
        background: #ffffff;
        box-shadow: 2.5px 2.5px 0px #000;
        margin: 1px 0;
      }

      .portada-title-motto {
        font-family: 'Space Mono', monospace;
        font-size: 6pt;
        font-style: italic;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #444;
        margin: 1px 0 0 0;
      }

      /* Portada Grid: Destacado + Sumario Secundario */
      .portada-content-flex {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2mm;
      }

      /* Bloque Destacado de Portada */
      .destacado-portada-box {
        border: 1.5px solid #000000;
        padding: 5px;
        background: #ffffff;
        box-shadow: 2px 2px 0px #000000;
      }

      .destacado-badge-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Space Mono', monospace;
        font-size: 6pt;
        font-weight: bold;
        text-transform: uppercase;
        border-bottom: 1px solid #000;
        padding-bottom: 2px;
        margin-bottom: 3px;
      }

      .destacado-badge-tag {
        background: #000;
        color: #fff;
        padding: 0.5px 3px;
      }

      .destacado-title-text {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 11pt;
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.15;
        margin: 2px 0 3px 0;
        text-align: left;
      }

      .destacado-columns-split {
        display: flex;
        gap: 6px;
        align-items: flex-start;
      }

      .destacado-img-wrap {
        width: 48mm;
        flex-shrink: 0;
      }

      .destacado-img-wrap img {
        width: 100%;
        height: 32mm;
        object-fit: cover;
        border: 1px solid #000;
        display: block;
      }

      .destacado-img-wrap figcaption {
        font-family: 'Space Mono', monospace;
        font-size: 5.5pt;
        color: #555;
        margin-top: 1px;
        font-style: italic;
      }

      .destacado-excerpt-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .destacado-excerpt-p {
        font-size: 7.5pt;
        line-height: 1.25;
        font-style: italic;
        margin: 0 0 3px 0;
        color: #111;
        border-left: 2px solid #000;
        padding-left: 4px;
        background: #fdfdfd;
      }

      .destacado-qr-mini {
        display: flex;
        align-items: center;
        gap: 4px;
        border: 1px solid #000;
        padding: 2px;
        background: #f9f9f9;
      }

      .destacado-qr-mini img {
        width: 10mm;
        height: 10mm;
        border: 0.5px solid #000;
        flex-shrink: 0;
      }

      .destacado-qr-mini span {
        font-family: 'Space Mono', monospace;
        font-size: 5.5pt;
        text-transform: uppercase;
        line-height: 1.1;
      }

      /* Sumario de Noticias Secundarias de Portada */
      .portada-sumario-box {
        border-top: 1.5px solid #000000;
        padding-top: 3px;
      }

      .portada-sumario-title {
        font-family: 'Space Mono', monospace;
        font-size: 7pt;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 3px;
        display: flex;
        justify-content: space-between;
      }

      .portada-sumario-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(38mm, 1fr));
        gap: 5px;
      }

      .portada-sumario-item {
        border: 1px dashed #777;
        padding: 3px 4px;
        background: #fafafa;
      }

      .portada-sumario-item h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 8.5pt;
        font-weight: bold;
        text-transform: uppercase;
        line-height: 1.15;
        margin: 0 0 2px 0;
      }

      .portada-sumario-item p {
        font-size: 7pt;
        line-height: 1.2;
        margin: 0;
        font-style: italic;
        color: #333;
      }

      .portada-footer {
        border-top: 1.5px solid #000000;
        padding-top: 1.5mm;
        display: flex;
        justify-content: space-between;
        font-family: 'Space Mono', monospace;
        font-size: 6.5pt;
        font-weight: bold;
        text-transform: uppercase;
      }

      /* ======================================================== */
      /* PÁGINA 8: CONTRAPORTADA O PÁGINA FINAL                   */
      /* ======================================================== */
      .page-empty-watermark {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #aaaaaa;
        font-family: 'Space Mono', monospace;
        font-size: 8pt;
        text-transform: uppercase;
        border: 1px dashed #cccccc;
        margin: 10mm 0;
      }

      /* ======================================================== */
      /* REGLAS ESTRICTAS DE IMPRESIÓN A4 APAISADO                */
      /* ======================================================== */
      @page {
        size: A4 landscape;
        margin: 0;
      }

      @media print {
        html, body {
          width: 297mm !important;
          height: 210mm !important;
          margin: 0 !important;
          padding: 0 !important;
          background: #ffffff !important;
        }

        .no-print {
          display: none !important;
        }

        .sheet-a4-landscape {
          width: 297mm !important;
          height: 210mm !important;
          max-height: 210mm !important;
          overflow: hidden !important;
          page-break-after: always !important;
          break-after: page !important;
          margin: 0 !important;
          padding: 0 !important;
          box-shadow: none !important;
          border: none !important;
          display: flex !important;
          flex-direction: row !important;
          box-sizing: border-box !important;
        }

        .sheet-fold-guide {
          border-left: 0.5px dashed #cccccc !important;
        }

        .page-empty-watermark {
          display: none !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- Barra de control superior para el navegador -->
    <div class="no-print max-w-[297mm] mx-auto mb-4 bg-yellow-300 border-2 border-black p-3 font-mono text-xs shadow-[3px_3px_0px_#000]">
      <div class="flex flex-wrap justify-between items-center gap-2 mb-2 pb-2 border-b border-black">
        <div>
          <span class="font-bold uppercase text-red-700">FANZINE A4 APAISADO (FOLLETO 2 HOJAS / 4 CARAS PLEGADAS AL CENTRO)</span>
          <div class="text-[11px] text-gray-800">
            Total: <strong>8 Páginas A5</strong> encartadas • Portada: <strong>1 Destacado + {portadaArticles.length} Portada</strong> • Interiores: <strong>{interiorArticles.length} Artículos con corte continuo</strong>
          </div>
        </div>
        <div class="flex gap-2">
          <button onclick="window.print()" class="brutal-btn brutal-btn-primary text-xs py-1 px-3">
            🖨️ Imprimir Navegador (A4 Apaisado)
          </button>
          <a href="/api/fanzine/export" class="brutal-btn text-xs py-1 px-3 bg-red-600 text-white hover:bg-red-700">
            📥 Descargar PDF Puppeteer
          </a>
          <a href="/admin/export-fanzine" class="brutal-btn text-xs py-1 px-3">
            ← Volver al Selector
          </a>
        </div>
      </div>
      <div class="text-[10.5px] text-gray-700 flex justify-between items-center">
        <span>📖 <strong>Instrucciones Papelería:</strong> Imprimir las 2 hojas a doble cara (voltear por borde corto). Doblar cada hoja por la mitad (148.5 mm) e insertar Hoja 2 dentro de Hoja 1.</span>
        <span class="font-bold bg-white px-2 py-0.5 border border-black">8 Páginas A5</span>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- HOJA 1: CARA EXTERIOR (ANVERSO)                          -->
    <!-- Izquierda: Pág 8 (Contraportada) | Derecha: Pág 1 (Portada) -->
    <!-- ======================================================== -->
    <div class="no-print max-w-[297mm] mx-auto mb-1 flex justify-between items-center text-[10px] font-mono bg-black text-white px-3 py-1 font-bold">
      <span>HOJA 1 (CARA EXTERIOR) — IMPRESIÓN ANVERSO</span>
      <span class="text-yellow-300">Pág. 8 (Contraportada / Final) [IZQ] ◀ | ▶ Pág. 1 (Portada) [DER]</span>
    </div>

    <div class="sheet-a4-landscape" id="sheet-1-front">
      <!-- Guía central de plegado -->
      <div class="sheet-fold-guide"></div>

      <!-- MITAD IZQUIERDA: PÁGINA 8 (CONTRAPORTADA / INTERIOR FINAL) -->
      <div class="half-page half-page-left" id="page-8-container">
        <div class="interior-page-header">
          <span>LA PARTE ARRENDATARIA — EDICIÓN IMPRESA POPULAR</span>
          <span>PÁG. 08</span>
        </div>
        <div class="interior-page-content" id="content-p8" data-page="8"></div>
        <div class="portada-footer" style="margin-top: 1mm;">
          <span>{siteDomain}</span>
          <span>FINAL DEL FANZINE</span>
        </div>
      </div>

      <!-- MITAD DERECHA: PÁGINA 1 (PORTADA PRINCIPAL) -->
      <div class="half-page half-page-right" id="page-1-container">
        <div class="portada-a5-container">
          <!-- Cabecera de Portada -->
          <header class="portada-header-compact">
            <div class="portada-header-top-meta">
              <span>España</span>
              <span>{new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}</span>
              <span>{siteDomain}</span>
            </div>
            <div class="portada-title-box">
