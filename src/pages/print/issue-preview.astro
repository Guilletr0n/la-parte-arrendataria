    <!-- ======================================================== -->
    <!-- SCRIPT DE PAGINACIÓN EDITORIAL CONTINUA Y CORTE CON QR   -->
    <!-- ======================================================== -->
    <script is:inline>
      async function paginateBooklet() {
        await document.fonts.ready;

        const dataScript = document.getElementById('interior-data');
        if (!dataScript) return;
        const articles = JSON.parse(dataScript.textContent || '[]');

        // Slots de páginas interiores en el orden de lectura estricto (Páginas 2 a 8)
        const pageNumbers = [2, 3, 4, 5, 6, 7, 8];
        const pageSlots = pageNumbers.map(n => document.getElementById('content-p' + n)).filter(Boolean);

        // Limpiar los contenedores por si se recarga
        pageSlots.forEach(slot => {
          slot.innerHTML = '';
        });

        let currentSlotIdx = 0;
        let isBookletFinished = false;

        for (let aIdx = 0; aIdx < articles.length; aIdx++) {
          if (isBookletFinished || currentSlotIdx >= pageSlots.length) break;

          const art = articles[aIdx];
          const isFirstArticleInBooklet = (aIdx === 0);

          // 1. Crear elementos individuales del artículo
          const elementsToInsert = [];

          // Separador si no es el primer artículo del fanzine
          if (!isFirstArticleInBooklet) {
            const sep = document.createElement('div');
            sep.className = 'fanzine-article-separator';
            elementsToInsert.push(sep);
          }

          // Header del artículo
          const header = document.createElement('div');
          header.className = 'fanzine-article-header';
          header.innerHTML = `
            <div class="meta-row">
              <span class="role-badge">${art.authorRole.toUpperCase()}</span>
              <span><strong>${art.author}</strong> • ${art.date}</span>
            </div>
            <h2 class="article-title">${art.title}</h2>
          `;
          elementsToInsert.push(header);

          // Foto (si existe)
          if (art.photoUrl) {
            const fig = document.createElement('figure');
            fig.className = 'article-photo-block';
            fig.innerHTML = `
              <img src="${art.photoUrl}" alt="${art.photoCaption || art.title}" class="halftone-img" />
              ${art.photoCaption ? `<figcaption>▲ ${art.photoCaption}</figcaption>` : ''}
            `;
            elementsToInsert.push(fig);
          }

          // Parsear bloques HTML del markdown
          const parser = new DOMParser();
          const doc = parser.parseFromString(art.htmlContent || '', 'text/html');
          const bodyChildren = Array.from(doc.body.children);
          
          // Si el primer hijo es un titular H1/H2 idéntico al título del artículo, omitirlo para no duplicar
          if (bodyChildren.length > 0) {
            const first = bodyChildren[0];
            if (['H1', 'H2', 'H3'].includes(first.tagName) && 
                first.textContent.trim().toUpperCase() === art.title.trim().toUpperCase()) {
              bodyChildren.shift();
            }
          }

          bodyChildren.forEach(child => elementsToInsert.push(child));

          // Bloque QR regular de finalización completa de artículo
          let qrNormalBlock = null;
          if (art.qrDataUrl) {
            qrNormalBlock = document.createElement('div');
            qrNormalBlock.className = 'article-qr-normal';
            qrNormalBlock.innerHTML = `
              <img src="${art.qrDataUrl}" alt="QR" />
              <div class="qr-normal-text">
                <span class="qr-normal-title">${art.hasExternalSource ? 'ESCANEA PARA LEER FUENTE ORIGINAL:' : 'ESCANEA PARA LEER EN LA WEB:'}</span>
                <span class="qr-normal-url">${art.effectiveUrl}</span>
              </div>
            `;
          }

          // 2. Insertar elementos distribuyendo a través de los slots de página
          for (let eIdx = 0; eIdx < elementsToInsert.length; eIdx++) {
            if (isBookletFinished || currentSlotIdx >= pageSlots.length) break;

            const el = elementsToInsert[eIdx];
            const currentSlot = pageSlots[currentSlotIdx];
            const isLastPage = (currentSlotIdx === pageSlots.length - 1);

            // Requisito 2: En la última página (Pág. 8) reservamos espacio para el QR de corte
            if (isLastPage) {
              const cutoffBlock = document.createElement('div');
              cutoffBlock.className = 'cutoff-qr-block';
              cutoffBlock.innerHTML = `
                <div class="cutoff-bar">[ ... TEXTO CORTADO POR LÍMITE DE PÁGINA IMPRESA ... ]</div>
                <div class="cutoff-flex">
                  ${art.qrDataUrl ? `<img src="${art.qrDataUrl}" class="cutoff-qr-img" alt="QR" />` : ''}
                  <div class="cutoff-meta">
                    <span class="cutoff-title">ESCANEA PARA LEER TEXTO COMPLETO Y FUENTE:</span>
                    <span class="cutoff-url">${art.effectiveUrl}</span>
                  </div>
                </div>
              `;

              currentSlot.appendChild(el);
              currentSlot.appendChild(cutoffBlock);

              if (currentSlot.scrollWidth > currentSlot.clientWidth) {
                // Desborda: quitar ambos y colocar el cutoffBlock final
                currentSlot.removeChild(cutoffBlock);
                currentSlot.removeChild(el);

                // Si es un párrafo <p>, intentar encajar tantas palabras como quepan antes del cutoffBlock
                if (el.tagName === 'P') {
                  const words = (el.textContent || '').split(' ');
                  if (words.length > 5) {
                    const partialP = document.createElement('p');
                    currentSlot.appendChild(partialP);
                    currentSlot.appendChild(cutoffBlock);

                    let low = 1, high = words.length, best = 0;
                    while (low <= high) {
                      const mid = Math.floor((low + high) / 2);
                      partialP.textContent = words.slice(0, mid).join(' ') + ' [...]';
                      if (currentSlot.scrollWidth <= currentSlot.clientWidth) {
                        best = mid;
                        low = mid + 1;
                      } else {
                        high = mid - 1;
                      }
                    }

                    if (best > 0) {
                      partialP.textContent = words.slice(0, best).join(' ') + ' [...]';
                    } else {
                      currentSlot.removeChild(partialP);
                    }
                  }
                }

                if (!currentSlot.contains(cutoffBlock)) {
                  currentSlot.appendChild(cutoffBlock);
                }

                isBookletFinished = true;
                break;
              } else {
                // Cabe con el cutoffBlock: retirar cutoffBlock para continuar con siguientes elementos
                currentSlot.removeChild(cutoffBlock);
              }
            } else {
              // En páginas 2 a 7: inserción normal. Si desborda, pasar el elemento a la siguiente página
              currentSlot.appendChild(el);

              if (currentSlot.scrollWidth > currentSlot.clientWidth) {
                currentSlot.removeChild(el);
                currentSlotIdx++;
                if (currentSlotIdx < pageSlots.length) {
                  pageSlots[currentSlotIdx].appendChild(el);
                } else {
                  isBookletFinished = true;
                  break;
                }
              }
            }
          }

          // Si el artículo terminó normalmente sin cortarse, añadir su QR normal
          if (!isBookletFinished && qrNormalBlock && currentSlotIdx < pageSlots.length) {
            const currentSlot = pageSlots[currentSlotIdx];
            currentSlot.appendChild(qrNormalBlock);
            if (currentSlot.scrollWidth > currentSlot.clientWidth) {
              currentSlot.removeChild(qrNormalBlock);
              currentSlotIdx++;
              if (currentSlotIdx < pageSlots.length) {
                pageSlots[currentSlotIdx].appendChild(qrNormalBlock);
              }
            }
          }
        }

        // Requisito 3: Si el usuario seleccionó un contenido muy corto, las páginas restantes quedan en blanco
        for (let i = currentSlotIdx + 1; i < pageSlots.length; i++) {
          const emptySlot = pageSlots[i];
          if (!emptySlot.hasChildNodes() || emptySlot.children.length === 0) {
            const watermark = document.createElement('div');
            watermark.className = 'page-empty-watermark';
            watermark.textContent = '— PÁGINA EN BLANCO —';
            emptySlot.appendChild(watermark);
          }
        }
      }

      // Ejecutar paginación cuando todas las imágenes y fuentes estén completamente listas
      async function initPagination() {
        if (document.fonts) await document.fonts.ready;
        await paginateBooklet();
      }

      if (document.readyState === 'complete') {
        initPagination();
      } else {
        window.addEventListener('load', initPagination);
      }
    </script>
